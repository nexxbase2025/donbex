rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    match /requests/{token}/receipt.{ext} {
      allow write: if
        request.resource != null
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow read: if false;
    }

    match /requests/{token}/logo.{ext} {
      allow write: if
        request.resource != null
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow read: if true;
    }
  }
}
