function donbexTranslateTextNode(node){
  if(donbexLang!=="en" || node.nodeType!==Node.TEXT_NODE) return;
  const raw=node.nodeValue;
  const trimmed=raw.trim();
  if(!trimmed) return;
  const translated=donbexUiEn.get(trimmed);
  if(translated){
    node.nodeValue=raw.replace(trimmed,translated);
    return;
  }
  // Small dynamic patterns, without touching functional values.
  let out=trimmed
    .replace(/^Activa tu Radio App por (\$[\d.]+)$/,"Activate your Radio App for $1")
    .replace(/^Activar edición por (.+)$/,"Activate editing for $1");
  if(out!==trimmed) node.nodeValue=raw.replace(trimmed,out);
}

function donbexTranslateElement(root=document){
  if(donbexLang!=="en") return;
  const walker=document.createTreeWalker(root,NodeFilter.SHOW_TEXT);
  const nodes=[]; while(walker.nextNode()) nodes.push(walker.currentNode);
  nodes.forEach(donbexTranslateTextNode);
  root.querySelectorAll?.('[placeholder],[aria-label],[title]').forEach(el=>{
    for(const attr of ['placeholder','aria-label','title']){
      const val=el.getAttribute(attr);
      if(val && donbexUiEn.has(val)) el.setAttribute(attr,donbexUiEn.get(val));
    }
  });
}

donbexTranslateElement(document);
if(donbexLang==="en"){
  new MutationObserver(muts=>{
    for(const m of muts){
      if(m.type==='characterData') donbexTranslateTextNode(m.target);
      for(const n of m.addedNodes||[]){
        if(n.nodeType===Node.TEXT_NODE) donbexTranslateTextNode(n);
        else if(n.nodeType===Node.ELEMENT_NODE) donbexTranslateElement(n);
      }
    }
  }).observe(document.body,{subtree:true,childList:true,characterData:true});
}

const donbexHowVideoBox=document.querySelector('#howVideoBox');
let donbexHowVideo=null;
function donbexHowVideoSource(){
  return donbexLang==='en'
    ? donbexHowVideoBox?.dataset.videoSrcEn
    : donbexHowVideoBox?.dataset.videoSrcEs;
}
function donbexPrepareHowVideo(){
  if(!donbexHowVideoBox || donbexHowVideo) return;
  const src=donbexHowVideoSource();
  if(!src) return;
  const v=document.createElement('video');
  v.className='how-video-player';
  v.controls=true;
  v.playsInline=true;
  v.preload='metadata';
  v.src=src;
  v.setAttribute('aria-label',donbexLang==='en'?'How DONBEX Radio App works':'Cómo funciona DONBEX Radio App');
  v.addEventListener('loadedmetadata',()=>{
    donbexHowVideoBox.innerHTML='';
    donbexHowVideoBox.appendChild(v);
    donbexHowVideo=v;
  },{once:true});
  v.addEventListener('error',()=>{
    // Keep the current localized placeholder until the corresponding video file is uploaded.
  },{once:true});
  v.load();
}

document.querySelector('#howItWorksBtn')?.addEventListener('click',()=>{
  donbexPrepareHowVideo();
  setTimeout(()=>donbexHowVideo?.play().catch(()=>{}),80);
});
function donbexStopHowVideo(){
  if(donbexHowVideo){ donbexHowVideo.pause(); donbexHowVideo.currentTime=0; }
}
document.querySelector('#closeHowItWorks')?.addEventListener('click',donbexStopHowVideo);
document.querySelector('#howItWorksBackdrop')?.addEventListener('click',donbexStopHowVideo);
