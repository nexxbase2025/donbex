
// ===== FINAL MOBILE QR DOWNLOAD — FIRST PRIORITY =====
window.addEventListener("click",function(e){
  const btn=e.target?.closest?.("#trackingDownloadQr,#downloadApprovedQr");
  if(!btn)return;

  e.preventDefault();
  e.stopImmediatePropagation();

  const order=(typeof trackingCurrentOrder!=="undefined" && trackingCurrentOrder)
    ? trackingCurrentOrder
    : window.__DONBEX_LAST_ORDER__;

  if(!order?.publicUrl){
    alert("No encontramos el enlace público de esta radio.");
    return;
  }

  const q=new URLSearchParams({url:order.publicUrl,download:"1"});
  if(order.logoUrl)q.set("logo",order.logoUrl);
  if(order.slug)q.set("name",order.slug);

  // Native browser download. On iPhone/iPad Safari this is saved in
  // Files > Downloads; on Android it is saved in Downloads.
  // Browsers do not have permission to silently write into Photos/Gallery.
  const a=document.createElement("a");
  a.href="/api/qr?"+q.toString();
  a.download=((order.slug||"radio")+"-QR.png");
  a.rel="noopener";
  document.body.appendChild(a);
  a.click();
  a.remove();

  const mobile=/iPhone|iPad|iPod|Android/i.test(navigator.userAgent);
  if(mobile){
    setTimeout(()=>{
      const ios=/iPhone|iPad|iPod/i.test(navigator.userAgent);
      alert(ios
        ? "QR descargado. En iPhone lo encontrarás en Archivos → Descargas. Si quieres tenerlo también en Fotos, abre el PNG y usa Compartir → Guardar imagen."
        : "QR descargado. Lo encontrarás en Descargas del dispositivo. La Galería puede tardar unos segundos en detectarlo."
      );
    },350);
  }
},true);

const $=s=>document.querySelector(s), $$=s=>[...document.querySelectorAll(s)];

const player=$("#player");
const audio=$("#audio");                 // MAIN AUDIO: never connected to Web Audio API.
const analysisAudio=$("#analysisAudio"); // ANALYSIS AUDIO: optional CORS-only helper.
const nameInput=$("#stationName"), namePreview=$("#namePreview");
const logoInput=$("#logoInput"), logoPreview=$("#logoPreview"), logoFallback=$("#logoFallback"), state=$("#streamState");
const playBtn=$("#playBtn"), playIcon=playBtn.querySelector(".play-icon");
const orbitBars=$("#orbitBars"), glassMeter=$("#glassMeter"), pulseCanvas=$("#pulseCanvas"), pulseCtx=pulseCanvas.getContext("2d");
const disc=$("#disc"), logoShell=$("#logoShell"), orbitReactive=$("#orbitReactive");
const stageVu=$("#stageVu"), leftVu=stageVu.querySelector(".left span"), rightVu=stageVu.querySelector(".right span");

let currentTemplate="orbit";
let audioCtx=null, analyser=null, analysisSource=null, freqData=null, timeData=null;
let realAnalysis=false, syntheticPhase=0, energySmooth=.15, playBusy=false;
let analysisTimeout=null;
let verifiedStreamUrl="";

const es=(navigator.language||"es").toLowerCase().startsWith("es");
const text={
  es:{
    orbit:["RADIO EN VIVO","AHORA AL AIRE","Transmitiendo en vivo"],
    glass:["SEÑAL ACTIVA","EN ESTE MOMENTO","Audio en directo"],
    stage:["AL AIRE","TRANSMISIÓN EN CURSO","Desde nuestro estudio digital"],
    pulse:["SEÑAL EN VIVO","AHORA SUENA","Streaming continuo"]
  },
  en:{
    orbit:["LIVE RADIO","NOW STREAMING","Live transmission"],
    glass:["ACTIVE SIGNAL","RIGHT NOW","Live audio"],
    stage:["ON AIR","BROADCAST IN PROGRESS","From our digital studio"],
    pulse:["LIVE SIGNAL","ON AIR NOW","Continuous streaming"]
  }
};
const TX=es?text.es:text.en;

const titles={
  orbit:es?"ORBIT — 3D / INMERSIVA":"ORBIT — 3D / IMMERSIVE",
  glass:es?"GLASS — EDITORIAL / CRISTAL":"GLASS — EDITORIAL / GLASS",
  stage:es?"STAGE — BROADCAST / ESCENARIO":"STAGE — BROADCAST / STAGE",
  pulse:es?"PULSE — MINIMAL / AUDIO":"PULSE — MINIMAL / AUDIO"
};

function buildVisualizers(){
  orbitBars.innerHTML="";
  for(let i=0;i<48;i++){
    const bar=document.createElement("i");
    const angle=(360/48)*i;
    bar.dataset.angle=angle;
    bar.style.transform=`rotate(${angle}deg) translateY(-2px)`;
    orbitBars.appendChild(bar);
  }
  glassMeter.innerHTML="";
  for(let i=0;i<32;i++) glassMeter.appendChild(document.createElement("i"));
  const legacyWave=$("#legacyWave");
  legacyWave.innerHTML="";
  for(let i=0;i<42;i++) legacyWave.appendChild(document.createElement("i"));
}
buildVisualizers();



const infoBadge=$("#infoBadge");
let weatherCache=null;
let weatherUnit=null;

function isFahrenheitLocale(){
  const lang=(navigator.language||"").toLowerCase();
  const region=(Intl.DateTimeFormat().resolvedOptions().locale||"").toUpperCase();
  return /US/.test(region) || lang.endsWith("-us");
}

function getTemperatureUnit(){
  if(weatherUnit) return weatherUnit;
  weatherUnit=isFahrenheitLocale()?"fahrenheit":"celsius";
  return weatherUnit;
}

function formatDateTime(mode){
  const now=new Date();
  if(mode==="time"){
    return new Intl.DateTimeFormat(es?"es":"en",{weekday:"short",hour:"numeric",minute:"2-digit"}).format(now);
  }
  return new Intl.DateTimeFormat(es?"es":"en",{day:"2-digit",month:"short",year:"numeric"}).format(now);
}

async function reverseLocation(lat,lon){
  try{
    const url=`https://geocoding-api.open-meteo.com/v1/reverse?latitude=${encodeURIComponent(lat)}&longitude=${encodeURIComponent(lon)}&count=1&language=${es?"es":"en"}&format=json`;
    const data=await fetch(url).then(r=>r.json());
    const item=data?.results?.[0];
    return item?{city:item.name||"",region:item.admin1||""}:{city:"",region:""};
  }catch{
    return {city:"",region:""};
  }
}

async function fetchWeather(lat,lon,place={}){
  const unit=getTemperatureUnit();
  const url=`https://api.open-meteo.com/v1/forecast?latitude=${encodeURIComponent(lat)}&longitude=${encodeURIComponent(lon)}&current=temperature_2m&temperature_unit=${unit}`;
  const wx=await fetch(url).then(r=>r.json());
  const temp=Math.round(wx?.current?.temperature_2m);
  return {
    city:place.city||"",
    region:place.region||"",
    temp:Number.isFinite(temp)?temp:null,
    symbol:unit==="fahrenheit"?"°F":"°C"
  };
}

async function weatherByIp(){
  try{
    const ip=await fetch("https://ipwho.is/").then(r=>r.json());
    if(!ip || ip.success===false) throw new Error("ip");
    return fetchWeather(ip.latitude,ip.longitude,{city:ip.city||"",region:ip.region_code||ip.region||""});
  }catch{
    return {city:"",region:"",temp:null,symbol:getTemperatureUnit()==="fahrenheit"?"°F":"°C"};
  }
}


async function updateInfoBadge(){
  if(currentTemplate==="glass"){
    infoBadge.textContent=formatDateTime("time");
    infoBadge.classList.add("show");
    return;
  }
  if(currentTemplate==="stage"){
    infoBadge.textContent=formatDateTime("date");
    infoBadge.classList.add("show");
    return;
  }
  if(currentTemplate==="orbit" || currentTemplate==="pulse"){
    infoBadge.textContent=es?"Cargando clima…":"Loading weather…";
    infoBadge.classList.add("show");
    if(!weatherCache) weatherCache=await weatherByIp();
    const w=weatherCache;
    if(w && w.temp!==null){
      const place=[w.city,w.region].filter(Boolean).join(", ");
      infoBadge.textContent=`${place?place+" · ":""}${w.temp}${w.symbol}`;
    }else{
      infoBadge.textContent=formatDateTime(currentTemplate==="orbit"?"time":"date");
    }
    return;
  }
  infoBadge.classList.remove("show");
}

setInterval(()=>{
  if(currentTemplate==="glass") infoBadge.textContent=formatDateTime("time");
  if(currentTemplate==="stage") infoBadge.textContent=formatDateTime("date");
},30000);


function setTemplate(t){
  currentTemplate=t;
  $$(".tpl").forEach(x=>x.classList.toggle("active",x.dataset.template===t));
  player.className="player "+t+(audio.paused?"":" is-playing");
  $("#templateTitle").textContent=titles[t];
  const [a,b,c]=TX[t];
  $("#statusLabel").textContent=a;
  $("#nowLabel").textContent=b;
  $("#liveText").textContent=c;
  $("#socialPreview").className="social-preview "+t+"-socials";
  updateInfoBadge();
}
$$(".tpl").forEach(b=>b.addEventListener("click",()=>setTemplate(b.dataset.template)));

nameInput.addEventListener("input",()=>{
  namePreview.textContent=nameInput.value||"Mi Radio Online";
  logoFallback.textContent=(nameInput.value.trim()[0]||"R").toUpperCase();
});

logoInput.addEventListener("change",e=>{
  const f=e.target.files?.[0];
  if(!f)return;
  const r=new FileReader();
  r.onload=()=>{
    logoPreview.src=r.result;
    logoPreview.style.display="block";
    logoFallback.style.display="none";
  };
  r.readAsDataURL(f);
});

function socialSvg(type){
  if(type==="instagram"){
    return `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="3.2" y="3.2" width="17.6" height="17.6" rx="5.2"></rect>
      <circle cx="12" cy="12" r="4.1"></circle>
      <circle cx="17.4" cy="6.6" r="1" fill="currentColor" stroke="none"></circle>
    </svg>`;
  }
  if(type==="facebook"){
    return `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M13.9 21v-8h2.75l.41-3.2H13.9V7.75c0-.93.26-1.56 1.59-1.56h1.7V3.33c-.29-.04-1.3-.13-2.47-.13-2.44 0-4.11 1.49-4.11 4.23V9.8H7.85V13h2.76v8h3.29Z"></path>
    </svg>`;
  }
  return `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M15.2 3.3c.34 2.22 1.62 3.54 3.8 3.83v3.12c-1.43.04-2.75-.4-3.78-1.1v5.9a5.46 5.46 0 1 1-4.72-5.4v3.16a2.36 2.36 0 1 0 1.58 2.24V3.3h3.12Z"></path>
  </svg>`;
}

function renderSocials(){
  const box=$("#socialPreview");
  box.innerHTML="";
  [
    ["instagram","Instagram",$("#instagram").value],
    ["facebook","Facebook",$("#facebook").value],
    ["tiktok","TikTok",$("#tiktok").value]
  ].forEach(([type,name,url])=>{
    if(!url)return;
    const a=document.createElement("a");
    a.href=url;
    a.target="_blank";
    a.rel="noopener noreferrer";
    a.setAttribute("aria-label",name);
    a.innerHTML=`${socialSvg(type)}<span class="social-label">${name}</span>`;
    box.appendChild(a);
  });
}
["instagram","facebook","tiktok"].forEach(id=>$("#"+id).addEventListener("input",renderSocials));

function stopMain(){
  audio.pause();
  audio.removeAttribute("src");
  audio.load();
  player.classList.remove("is-playing");
  playIcon.textContent="▶";
}

function stopAnalysis(){
  realAnalysis=false;
  if(analysisTimeout){clearTimeout(analysisTimeout);analysisTimeout=null}
  try{analysisAudio.pause()}catch{}
  analysisAudio.removeAttribute("src");
  analysisAudio.load();
  if(audioCtx && audioCtx.state==="running") audioCtx.suspend().catch(()=>{});
}

async function startOptionalAnalysis(url){
  stopAnalysis();
  try{
    analysisAudio.crossOrigin="anonymous";
    analysisAudio.muted=true;
    analysisAudio.volume=0;
    analysisAudio.src=url;
    analysisAudio.load();

    if(!audioCtx){
      audioCtx=new (window.AudioContext||window.webkitAudioContext)();
      analyser=audioCtx.createAnalyser();
      analyser.fftSize=512;
      analyser.smoothingTimeConstant=.76;
      analysisSource=audioCtx.createMediaElementSource(analysisAudio);
      analysisSource.connect(analyser);
      // Do NOT connect analysis node to destination: main audio handles sound.
      freqData=new Uint8Array(analyser.frequencyBinCount);
      timeData=new Uint8Array(analyser.fftSize);
    }
    if(audioCtx.state==="suspended") await audioCtx.resume();
    await analysisAudio.play();

    // Give analyser a moment to prove it is receiving non-zero samples.
    analysisTimeout=setTimeout(()=>{
      if(!analyser)return;
      analyser.getByteFrequencyData(freqData);
      const avg=freqData.reduce((a,b)=>a+b,0)/freqData.length;
      realAnalysis=avg>1.5;
      if(!realAnalysis){
        try{analysisAudio.pause()}catch{}
      }
    },1200);
  }catch{
    realAnalysis=false;
  }
}

function syncPublishAvailability(){
  const publishBtn=$("#generate");
  const requirement=$("#publishRequirement");
  if(!publishBtn)return;
  // Only enforce this gate on the public creator route. Private edit flows keep their existing controls.
  if(location.pathname.startsWith("/edit/")){ publishBtn.disabled=false; return; }
  const current=$("#streamUrl")?.value.trim()||"";
  const verified=!!current && current===verifiedStreamUrl;
  publishBtn.disabled=!verified;
  publishBtn.classList.toggle("stream-verified",verified);
  if(requirement){
    requirement.classList.toggle("ok",verified);
    requirement.innerHTML=verified
      ? "✓ Stream verificado. Ya puedes publicar tu Radio App."
      : "Agrega una URL HTTPS y pulsa <b>Probar stream</b>. El botón se activará cuando confirmemos que la señal reproduce correctamente.";
  }
}

$("#streamUrl")?.addEventListener("input",()=>{
  const current=$("#streamUrl").value.trim();
  if(current!==verifiedStreamUrl)verifiedStreamUrl="";
  syncPublishAvailability();
});

async function connectLive(){
  if(playBusy)return;
  playBusy=true;
  const url=$("#streamUrl").value.trim().replace(/^\s+|\s+$/g,"");
  if(!url.startsWith("https://")){
    state.textContent=es?"Debe usar HTTPS":"HTTPS required";
    state.style.color="#ff8b8b";
    verifiedStreamUrl="";
    syncPublishAvailability();
    playBusy=false;
    return false;
  }

  stopMain();
  state.textContent=es?"Conectando al vivo…":"Connecting live…";
  state.style.color="#93a5b6";

  try{
    // MAIN stream: plain HTML5 audio, no crossOrigin and no WebAudio.
    audio.src=url;
    audio.load();
    await audio.play();

    player.classList.add("is-playing");
    playIcon.textContent="❚❚";
    state.textContent=es?"✓ Stream en vivo · verificado":"✓ Live stream · verified";
    state.style.color="#75ffc8";
    verifiedStreamUrl=url;
    syncPublishAvailability();

    // Analysis is completely separate, so failure here can never silence main audio.
    startOptionalAnalysis(url);
    playBusy=false;
    return true;
  }catch(err){
    stopMain();
    stopAnalysis();
    state.textContent=es?"El navegador no pudo reproducir esta URL":"Browser could not play this URL";
    state.style.color="#ff9b86";
    verifiedStreamUrl="";
    syncPublishAvailability();
    playBusy=false;
    return false;
  }
}

$("#testStream").addEventListener("click",connectLive);

playBtn.addEventListener("click",async()=>{
  if(playBusy)return;

  if(!audio.paused && audio.src){
    // STOP rather than "pause". A live station should not resume old buffered audio.
    stopMain();
    stopAnalysis();
    state.textContent=es?"Detenido · Play vuelve al punto actual en vivo":"Stopped · Play returns to current live point";
    state.style.color="#9badbd";
    return;
  }

  await connectLive();
});

audio.addEventListener("ended",()=>{
  player.classList.remove("is-playing");
  playIcon.textContent="▶";
});
audio.addEventListener("error",()=>{
  if(!playBusy){
    state.textContent=es?"Se perdió la señal. Pulsa Play para reconectar.":"Signal lost. Press Play to reconnect.";
    state.style.color="#ffb37c";
  }
});

function metrics(){
  if(realAnalysis && analyser){
    analyser.getByteFrequencyData(freqData);
    analyser.getByteTimeDomainData(timeData);
    let sum=0,bass=0,mid=0,high=0;
    for(let i=0;i<freqData.length;i++){
      const v=freqData[i]/255;
      sum+=v;
      if(i<20)bass+=v;
      else if(i<80)mid+=v;
      else high+=v;
    }
    return {
      real:true,
      energy:sum/freqData.length,
      bass:bass/20,
      mid:mid/60,
      high:high/Math.max(1,freqData.length-80)
    };
  }

  // Intelligent fallback when CORS blocks frequency analysis.
  syntheticPhase+=audio.paused?.028:.075;
  const liveFactor=audio.paused?.45:1;
  return {
    real:false,
    energy:liveFactor*(.22+Math.sin(syntheticPhase*1.8)*.06+Math.sin(syntheticPhase*4.3)*.035),
    bass:liveFactor*(.30+Math.sin(syntheticPhase*1.2)*.13),
    mid:liveFactor*(.25+Math.sin(syntheticPhase*2.4+1.1)*.11),
    high:liveFactor*(.18+Math.sin(syntheticPhase*3.7+2.3)*.09)
  };
}

function drawPulse(m){
  const w=pulseCanvas.width,h=pulseCanvas.height;
  pulseCtx.clearRect(0,0,w,h);
  pulseCtx.lineCap="round";
  pulseCtx.lineJoin="round";
  pulseCtx.lineWidth=3;
  pulseCtx.strokeStyle=`rgba(184,115,255,${.5+m.energy*.5})`;
  pulseCtx.shadowBlur=18+m.energy*25;
  pulseCtx.shadowColor="rgba(166,108,255,.6)";
  pulseCtx.beginPath();
  for(let x=0;x<w;x++){
    let y;
    if(realAnalysis && timeData){
      const idx=Math.floor((x/w)*(timeData.length-1));
      y=(timeData[idx]/255)*h;
    }else{
      y=h/2
        + Math.sin(x*.035+syntheticPhase*3.2)*h*.16*(.5+m.energy*1.8)
        + Math.sin(x*.011-syntheticPhase*1.7)*h*.06;
    }
    x===0?pulseCtx.moveTo(x,y):pulseCtx.lineTo(x,y);
  }
  pulseCtx.stroke();
}

function animate(){
  const m=metrics();
  energySmooth=energySmooth*.76+m.energy*.24;
  const energy=Math.min(1,Math.max(.03,energySmooth*2.35));
  const bass=Math.min(1,Math.max(.03,m.bass*1.9));
  const mid=Math.min(1,Math.max(.03,m.mid*1.9));
  const high=Math.min(1,Math.max(.03,m.high*2));

  namePreview.style.textShadow=`0 0 ${6+energy*26}px rgba(110,225,255,${.05+energy*.35})`;

  if(currentTemplate==="orbit"){
    const t=performance.now()/60;
    disc.style.transform=`rotate(${t%360}deg) scale(${1+energy*.035})`;
    logoShell.style.transform=`rotate(${-(t%360)}deg) scale(${1+bass*.045})`;
    orbitReactive.style.transform=`scale(${1+energy*.18})`;
    orbitReactive.style.boxShadow=`0 0 ${18+energy*58}px rgba(88,229,255,${.12+energy*.36})`;
  }else if(currentTemplate==="glass"){
    disc.style.transform=`rotate(-4deg) scale(${1+energy*.012})`;
    logoShell.style.transform=`scale(${1+energy*.03})`;
    logoShell.style.filter=`brightness(${1+energy*.35}) saturate(${1+mid*.25})`;
  }else if(currentTemplate==="stage"){
    disc.style.transform=`scale(${1+bass*.025})`;
    logoShell.style.transform=`scale(${1+bass*.03})`;
    logoShell.style.boxShadow=`0 0 ${20+bass*70}px rgba(255,177,84,${.10+bass*.36})`;
  }else{
    disc.style.transform=`scale(${1+energy*.025})`;
    logoShell.style.transform=`scale(${1+energy*.03})`;
    logoShell.style.filter=`brightness(${1+energy*.50})`;
  }

  [...orbitBars.children].forEach((b,i)=>{
    const zone=i%3===0?bass:i%3===1?mid:high;
    const liveWave=.45+.55*Math.abs(Math.sin(syntheticPhase*2.2+i*.36));
    b.style.height=`${6+zone*liveWave*34}px`;
    b.style.opacity=.28+zone*.72;
  });

  [...glassMeter.children].forEach((b,i)=>{
    const zone=i<9?bass:i<23?mid:high;
    const liveWave=.4+.6*Math.abs(Math.sin(syntheticPhase*2.8+i*.31));
    b.style.height=`${5+zone*liveWave*56}px`;
    b.style.opacity=.34+zone*.66;
  });

  leftVu.style.width=`${5+Math.min(1,bass*.75+mid*.25)*94}%`;
  rightVu.style.width=`${5+Math.min(1,mid*.6+high*.4)*94}%`;


  // Main spectrum bar: always visibly animated, real-audio when available.
  const spectrum=[...$("#legacyWave").children];
  if(currentTemplate==="orbit"){
    spectrum.forEach((bar,i)=>{
      let v;
      if(realAnalysis && freqData && freqData.length){
        const idx=Math.min(freqData.length-1,Math.floor((i/spectrum.length)*freqData.length));
        v=freqData[idx]/255;
      }else{
        const zone=i<spectrum.length*.28?bass:i<spectrum.length*.70?mid:high;
        const wave=.35+.65*Math.abs(Math.sin(syntheticPhase*2.6+i*.42));
        v=zone*wave;
      }
      bar.style.height=`${5+Math.max(.05,v)*38}px`;
      bar.style.opacity=`${.30+Math.min(1,v)*.70}`;
    });
  }

  drawPulse({energy,bass,mid,high});
  requestAnimationFrame(animate);
}
animate();

$("#generate").addEventListener("click",e=>{
  if(location.pathname.startsWith("/edit/"))return;
  const u=$("#streamUrl").value.trim();
  if(!u || u!==verifiedStreamUrl){
    e.preventDefault();
    e.stopImmediatePropagation();
    state.textContent=es?"Primero prueba y verifica la URL del streaming":"Test and verify the streaming URL first";
    state.style.color="#ff8b8b";
    syncPublishAvailability();
    $("#streamUrl")?.focus();
  }
},true);

$("#copyDemo")?.addEventListener("click",async()=>{
  const demo=location.href.split("#")[0]+"#demo="+encodeURIComponent(nameInput.value);
  try{
    await navigator.clipboard.writeText(demo);
    $("#copyDemo").textContent=es?"Copiado ✓":"Copied ✓";
  }catch{}
});

$("#downloadQr")?.addEventListener("click",()=>{
  const a=document.createElement("a");
  a.download=(nameInput.value||"radio").replace(/\s+/g,"-").toLowerCase()+"-qr.png";
  a.href=$("#qrCanvas").toDataURL("image/png");
  a.click();
});




// ===== V9 COMPACT CHECKOUT =====
const BASE_PRICE=11.99;
const editPlans={monthly:{label:"Edición 1 mes",price:5.99},six:{label:"Edición 6 meses",price:24.99},year:{label:"Edición 12 meses",price:39.99}};
let selectedEditPlan=null,selectedPaymentMethod="paypal",paymentMethodChosen=false;
const checkoutModal=$("#checkoutModal");

function slugify(value){
  return (value||"mi-radio-online").toLowerCase().normalize("NFD")
    .replace(/[\u0300-\u036f]/g,"")
    .replace(/[^a-z0-9]+/g,"-")
    .replace(/^-+|-+$/g,"") || "mi-radio-online";
}
function currentSlug(){
  return slugify(nameInput.value);
}
function syncCheckoutIdentity(){
  const slug=currentSlug();
  const generatedSlug=$("#generatedSlug"); if(generatedSlug)generatedSlug.textContent=slug;
  $("#checkoutSlug").textContent=slug;
  $("#checkoutStationName").textContent=nameInput.value.trim()||"Mi Radio Online";
}
function openCheckout(){
  syncCheckoutIdentity();
  paymentMethodChosen=false;
  selectedPaymentMethod="paypal";
  $$("[data-method]").forEach(x=>x.classList.toggle("active",x.dataset.method==="paypal"));
  $("#paypalInfo")?.classList.add("hidden");
  $("#bankInfo")?.classList.add("hidden");
  $("#purchaseForm")?.classList.add("hidden");
  $("#purchaseForm")?.classList.remove("gateway-ready");
  checkoutModal.querySelector(".checkout-card")?.classList.remove("gateway-phase");
  $("#paypalButtonContainer")?.classList.add("hidden");
  $("#paypalState")?.classList.add("hidden");
  const actionHint=$("#paymentActionHint");
  if(actionHint){ actionHint.textContent=""; actionHint.classList.add("hidden"); }
  const submit=$("#purchaseForm .submit-order");
  if(submit){submit.disabled=false;submit.textContent="Continuar al pago";submit.classList.remove("hidden");}
  checkoutModal.classList.add("open");
  checkoutModal.setAttribute("aria-hidden","false");
  document.body.style.overflow="hidden";
}
function closeCheckout(){
  checkoutModal.querySelector(".checkout-card")?.classList.remove("gateway-phase");
  $("#purchaseForm")?.classList.remove("gateway-ready");
  checkoutModal.classList.remove("open");
  checkoutModal.setAttribute("aria-hidden","true");
  document.body.style.overflow="";
}
$("#closeCheckout").addEventListener("click",closeCheckout);
$("#checkoutBackdrop").addEventListener("click",closeCheckout);
nameInput.addEventListener("input",syncCheckoutIdentity);

function updatePurchaseTotal(){
  const extra=selectedEditPlan?editPlans[selectedEditPlan].price:0;
  const total=Number((BASE_PRICE+extra).toFixed(2));
  $("#purchaseTotal").textContent=`$${total.toFixed(2)}`;
  $("#editSummaryRow").classList.toggle("hidden",!selectedEditPlan);
  const selectedSummary=$("#selectedEditPlanSummary");
  const selectedText=$("#selectedEditPlanText");
  if(selectedEditPlan){
    const plan=editPlans[selectedEditPlan];
    $("#editSummaryLabel").textContent=plan.label;
    $("#editSummaryPrice").textContent=`$${extra.toFixed(2)}`;
    if(selectedText) selectedText.textContent=`${plan.label.replace("Edición ","")} · $${extra.toFixed(2)}`;
    selectedSummary?.classList.remove("hidden");
    if($("#checkoutTitle")) $("#checkoutTitle").textContent=`Activa tu Radio App · Total $${total.toFixed(2)}`;
  }else{
    selectedSummary?.classList.add("hidden");
    if($("#checkoutTitle")) $("#checkoutTitle").textContent=`Activa tu Radio App por $${BASE_PRICE.toFixed(2)}`;
  }
}
$$("[data-edit-plan]").forEach(btn=>btn.addEventListener("click",()=>{
  selectedEditPlan=selectedEditPlan===btn.dataset.editPlan?null:btn.dataset.editPlan;
  $$("[data-edit-plan]").forEach(x=>x.classList.toggle("active",x.dataset.editPlan===selectedEditPlan));
  updatePurchaseTotal();
}));
$("#removeSelectedEditPlan")?.addEventListener("click",()=>{
  selectedEditPlan=null;
  $$("[data-edit-plan]").forEach(x=>x.classList.remove("active"));
  updatePurchaseTotal();
});

$$("[data-method]").forEach(btn=>btn.addEventListener("click",()=>{
  paymentMethodChosen=true;
  selectedPaymentMethod=btn.dataset.method;
  $$("[data-method]").forEach(x=>x.classList.toggle("active",x===btn));

  const form=$("#purchaseForm");
  form?.classList.remove("hidden","gateway-ready");
  const submit=form?.querySelector(".submit-order");
  if(submit){submit.disabled=false;submit.classList.remove("hidden");}
  $("#paypalButtonContainer")?.classList.add("hidden");
  $("#paypalState")?.classList.add("hidden");

  const actionHint=$("#paymentActionHint");
  if(selectedPaymentMethod==="paypal"){
    $("#paypalInfo")?.classList.remove("hidden");
    $("#bankInfo")?.classList.add("hidden");
    $("#receiptField")?.classList.add("hidden");
    const receipt=$("#receiptInput"); if(receipt) receipt.required=false;
    if($("#purchaseDataTitle")) $("#purchaseDataTitle").textContent="Datos para recibir tu Radio App";
    if($("#purchaseDataSubtitle")) $("#purchaseDataSubtitle").textContent="El correo es obligatorio: ahí recibirás el QR, los enlaces y tu acceso privado";
    if(submit) submit.textContent="Continuar al pago seguro";
    if(actionHint){
      actionHint.textContent="Elige PayPal o tarjeta y completa el pago en el módulo seguro.";
      actionHint.classList.remove("hidden");
    }
  }else{
    $("#paypalInfo")?.classList.add("hidden");
    $("#bankInfo")?.classList.remove("hidden");
    $("#receiptField")?.classList.remove("hidden");
    const receipt=$("#receiptInput"); if(receipt) receipt.required=true;
    paypalPendingOrder=null;
    if($("#purchaseDataTitle")) $("#purchaseDataTitle").textContent="Datos de la transferencia";
    if($("#purchaseDataSubtitle")) $("#purchaseDataSubtitle").textContent="Completa tus datos y adjunta el comprobante";
    if(submit) submit.textContent="Enviar comprobante y solicitar aprobación";
    if(actionHint){
      actionHint.textContent="Adjunta tu comprobante. La solicitud quedará pendiente hasta que la transferencia sea verificada y aprobada.";
      actionHint.classList.remove("hidden");
    }
  }
  form?.scrollIntoView({behavior:"smooth",block:"nearest"});
}));

$("#receiptInput").addEventListener("change",()=>{
  const file=$("#receiptInput").files?.[0];if(!file)return;
  const r=new FileReader();
  r.onload=()=>{$("#receiptImage").src=r.result;$("#receiptPreview").classList.remove("hidden")};
  r.readAsDataURL(file);
});
$("#removeReceipt").addEventListener("click",()=>{
  $("#receiptInput").value="";
  $("#receiptImage").removeAttribute("src");
  $("#receiptPreview").classList.add("hidden");
});

function buildCurrentOrder(fd,method){
  const slug=currentSlug ? currentSlug() : (nameInput.value||"mi-radio-online").toLowerCase().replace(/[^a-z0-9]+/g,"-").replace(/^-|-$/g,"");
  const orderToken=(crypto.randomUUID?crypto.randomUUID():Math.random().toString(36).slice(2)+Date.now());
  const editToken=(crypto.randomUUID?crypto.randomUUID():Math.random().toString(36).slice(2)+Date.now());
  return {
    id:"RAD-"+Date.now(), trackingToken:orderToken,
    trackingUrl:`https://radio.donbex.com/order/${orderToken}`,
    stationName:nameInput.value.trim(), slug,
    publicUrl:`https://radio.donbex.com/${slug}`,
    privateEditUrl:`https://radio.donbex.com/edit/${editToken}`,
    editToken,
    customer:{name:fd.get("customerName")||"",email:fd.get("customerEmail")||"",whatsapp:`${fd.get("countryCode")||""}${fd.get("customerWhatsapp")||""}`},
    checkoutEditPlan:selectedEditPlan||null,
    payment:{method,basePrice:BASE_PRICE,editPlan:selectedEditPlan,editPrice:selectedEditPlan?editPlans[selectedEditPlan].price:0,status:"pending"},
    radio:{template:currentTemplate,streamUrl:$("#streamUrl").value.trim(),instagram:$("#instagram").value.trim(),facebook:$("#facebook").value.trim(),tiktok:$("#tiktok").value.trim()},
    status:"pending_approval",createdAt:new Date().toISOString()
  };
}

async function saveOrderForPayment(order,receiptFile=null){
  window.__DONBEX_LAST_ORDER__=order;
  return new Promise((resolve,reject)=>{
    const ok=e=>{cleanup();resolve(e.detail.order)};
    const bad=e=>{cleanup();reject(new Error(e.detail?.message||"No se pudo guardar la solicitud"))};
    const cleanup=()=>{window.removeEventListener("donbex:order-saved",ok);window.removeEventListener("donbex:order-error",bad)};
    window.addEventListener("donbex:order-saved",ok,{once:true});
    window.addEventListener("donbex:order-error",bad,{once:true});
    window.dispatchEvent(new CustomEvent("donbex:submit-order",{detail:{order,receiptFile,logoFile:$("#logoInput").files?.[0]||null}}));
  });
}

async function prepareOrderForPayPal(order){
  window.__DONBEX_LAST_ORDER__=order;
  return new Promise((resolve,reject)=>{
    const ok=e=>{cleanup();resolve(e.detail.order)};
    const bad=e=>{cleanup();reject(new Error(e.detail?.message||"No se pudo preparar el pago"))};
    const cleanup=()=>{window.removeEventListener("donbex:paypal-order-prepared",ok);window.removeEventListener("donbex:paypal-order-prepare-error",bad)};
    window.addEventListener("donbex:paypal-order-prepared",ok,{once:true});
    window.addEventListener("donbex:paypal-order-prepare-error",bad,{once:true});
    window.dispatchEvent(new CustomEvent("donbex:prepare-paypal-order",{detail:{order,logoFile:$("#logoInput").files?.[0]||null}}));
  });
}

$("#purchaseForm").addEventListener("submit",async e=>{
  e.preventDefault();
  const form=e.currentTarget;
  if(!paymentMethodChosen)return;
  if(!form.reportValidity())return;
  const fd=new FormData(form);
  const submitButton=form.querySelector(".submit-order");
  if(selectedPaymentMethod==="paypal"){
    try{
      submitButton.disabled=true; submitButton.textContent="Preparando pago…";
      $("#paypalState").textContent="Preparando el pago seguro dentro de DONBEX…";
      const order=buildCurrentOrder(fd,"paypal");
      // IMPORTANT: do not create radioRequests yet. Otherwise the Admin sees
      // an unpaid PayPal attempt as if it needed manual approval.
      // Keep the proven V26.5 sequence: prepare the DONBEX order first,
      // then render/load PayPal. Do not preload the SDK in parallel.
      paypalPendingOrder=await prepareOrderForPayPal(order);
      $("#paymentActionHint")?.classList.add("hidden");
      form.classList.add("gateway-ready");
      checkoutModal.querySelector(".checkout-card")?.classList.add("gateway-phase");
      await renderPayPalButtons();
      submitButton.classList.add("hidden");
      $("#paypalState")?.classList.remove("hidden");
      $("#paypalState").textContent="Elige PayPal o tarjeta y completa el pago en el módulo seguro.";
      $("#paypalButtonContainer")?.scrollIntoView({behavior:"smooth",block:"nearest"});
    }catch(err){
      console.error(err);
      form.classList.remove("gateway-ready");
      checkoutModal.querySelector(".checkout-card")?.classList.remove("gateway-phase");
      $("#paypalState")?.classList.remove("hidden");
      $("#paypalState").textContent="No se pudo preparar el pago en línea. Revisa la configuración de PayPal e inténtalo nuevamente.";
      submitButton.disabled=false;submitButton.textContent="Continuar al pago seguro";submitButton.classList.remove("hidden");
    }
    return;
  }
  const receiptFile=$("#receiptInput").files?.[0];
  if(!receiptFile)return;
  const order=buildCurrentOrder(fd,"bank");
  $("#paymentActionHint")?.classList.add("hidden");
  submitButton.disabled=true;submitButton.textContent="Guardando solicitud…";
  try{await saveOrderForPayment(order,receiptFile)}catch(err){console.error(err);submitButton.disabled=false;submitButton.textContent="Enviar comprobante y solicitar aprobación"}
});

updatePurchaseTotal();
syncCheckoutIdentity();

