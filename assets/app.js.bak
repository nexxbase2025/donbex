function renderApprovedState(order){
  if(!order)return;

  $("#pendingBox").classList.add("approved");
  $("#trackingStatusIcon").classList.remove("pending");
  $("#trackingStatusIcon").classList.add("approved");
  $("#trackingKicker").textContent="SOLICITUD APROBADA";
  $("#trackingTitle").textContent="✓ Radio App activada";
  $("#trackingMessage").textContent="Tu Radio App ya está activa. Desde aquí puedes abrirla, copiar el enlace público, descargar el QR con tu logo y guardar tu acceso privado.";
  $("#approvedActions").classList.remove("hidden");

  $("#approvedPublicUrl").textContent=order.publicUrl;
  $("#approvedPrivateUrl").textContent=order.privateEditUrl;

  if(window.QRCode){
    const canvas=$("#approvedQrCanvas");
    QRCode.toCanvas(canvas,order.publicUrl,{width:420,margin:2,errorCorrectionLevel:"H"},()=>{
      const logoUrl=order.logoUrl;
      if(!logoUrl)return;
      const img=new Image();
      img.crossOrigin="anonymous";
      img.onload=()=>{
        const ctx=canvas.getContext("2d");
        const size=Math.round(canvas.width*.20);
        const x=(canvas.width-size)/2;
        const y=(canvas.height-size)/2;
        const pad=Math.round(size*.10);
        ctx.save();
        ctx.fillStyle="#fff";
        ctx.beginPath();
        if(ctx.roundRect)ctx.roundRect(x-pad,y-pad,size+pad*2,size+pad*2,14);
        else ctx.rect(x-pad,y-pad,size+pad*2,size+pad*2);
        ctx.fill();
        ctx.beginPath();
        ctx.arc(canvas.width/2,canvas.height/2,size/2,0,Math.PI*2);
        ctx.clip();
        ctx.drawImage(img,x,y,size,size);
        ctx.restore();
      };
      img.src=logoUrl;
    });
  }
}

