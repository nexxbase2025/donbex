// ===== V14 FIREBASE UI HOOKS =====
window.addEventListener("donbex:order-saved",e=>{
  const order=e.detail.order;
  window.__DONBEX_LAST_ORDER__=order;

  const form=$("#purchaseForm");
  const isOnline=order?.payment?.method==="paypal";

  // Pago en línea: guardar la solicitud previa al checkout NO significa
  // “pendiente de aprobación”. La pantalla se mantiene en pago seguro.
  if(isOnline){
    $("#pendingBox")?.classList.add("hidden");
    const btn=form?.querySelector(".submit-order");
    if(btn)btn.disabled=false;
    return;
  }

  // Transferencia: comprobante recibido -> abrir directamente el panel privado
  // de seguimiento. La aprobación sigue siendo manual en DONBEX Admin.
  const btn=form?.querySelector(".submit-order");
  if(btn){btn.disabled=false;btn.textContent="Enviar comprobante y solicitar aprobación";}
  location.href=order.trackingUrl;
});

window.addEventListener("donbex:order-error",e=>{
  const form=$("#purchaseForm");
  const btn=form?.querySelector(".submit-order");
  if(btn){
    btn.disabled=false;
    btn.textContent="Enviar comprobante y solicitar aprobación";
  }
  alert("No pudimos guardar la solicitud. Revisa la conexión y las reglas de Firebase e inténtalo nuevamente.");
});

window.addEventListener("donbex:tracking-loaded",e=>{
  const order=e.detail.order;
  window.__DONBEX_LAST_ORDER__=order;
  const isTrackingRoute=/^\/order\//.test(location.pathname);
  if(isTrackingRoute)return; // Dedicated trackingView renders the routed panel.
  const onlineWaiting=order?.payment?.method==="paypal" && order.status!=="approved" && order.status!=="rejected";

  // El snapshot que se crea antes de abrir el checkout en línea no debe
  // convertir la compra actual en “Pendiente de aprobación”.
  if(onlineWaiting && !isTrackingRoute)return;

  if(typeof openCheckout==="function")openCheckout();
  $("#purchaseForm")?.classList.add("hidden");
  $("#pendingBox")?.classList.remove("hidden");

  if($("#trackingUrlText"))$("#trackingUrlText").textContent=order.trackingUrl||location.href;

  if(order.status==="approved"){
    if(typeof renderApprovedState==="function")renderApprovedState(order);
  }else if(order.status==="rejected"){
    $("#trackingKicker").textContent="SOLICITUD REVISADA";
    $("#trackingTitle").textContent="Solicitud no aprobada";
    $("#trackingMessage").textContent=order.rejectionReason||"Revisa tu comprobante o contacta a soporte.";
  }else if(order?.payment?.method==="paypal"){
    $("#trackingKicker").textContent="PAGO EN LÍNEA";
    $("#trackingTitle").textContent="Pago todavía no confirmado";
    $("#trackingMessage").textContent="Tu Radio App se activará automáticamente cuando el pago en línea quede confirmado.";
  }else{
    $("#trackingKicker").textContent="COMPROBANTE RECIBIDO";
    $("#trackingTitle").textContent="Pendiente de aprobación";
    $("#trackingMessage").textContent="Tu transferencia está pendiente de verificación. Cuando sea aprobada, este panel se desbloqueará automáticamente.";
  }
});


// ===== V15 PUBLIC RADIO ROUTE =====
window.addEventListener("donbex:public-radio-loaded",e=>{
  const radio=e.detail.radio;
  document.body.classList.add("public-mode");

  const shell=$("#publicRadioShell");
  const loading=$("#publicLoading");
  loading?.classList.add("hidden");

  // Move the existing preview phone into the public shell so designs/animations stay identical.
  const device=document.querySelector(".preview-area .device");
  if(device){
    let host=shell.querySelector(".public-player-host");
    if(!host){
      host=document.createElement("div");
      host.className="public-player-host";
      shell.querySelector(".public-radio-wrap").appendChild(host);
    }
    host.appendChild(device);
  }

  nameInput.value=radio.stationName||"Mi Radio Online";
  namePreview.textContent=radio.stationName||"Mi Radio Online";
  $("#streamUrl").value=radio.streamUrl||"";
  $("#instagram").value=radio.instagram||"";
  $("#facebook").value=radio.facebook||"";
  $("#tiktok").value=radio.tiktok||"";

  if(radio.logoUrl){
    logoPreview.src=radio.logoUrl;
    logoPreview.style.display="block";
    logoFallback.style.display="none";
  }

  setTemplate(radio.template||"orbit");
  renderSocials();

  // In public mode the play button connects directly to the saved live stream.
  state.textContent=es?"Listo para escuchar":"Ready to listen";
  state.style.color="#75ffc8";
});

window.addEventListener("donbex:public-radio-missing",()=>{
  document.body.classList.add("public-mode");
  $("#publicLoading")?.classList.add("hidden");
  $("#publicError")?.classList.remove("hidden");
});

setTemplate("orbit");


// ===== V16 QR MOBILE DOWNLOAD =====
async function donbexDownloadQR(){
  const canvas=document.querySelector("#qrCanvas, canvas.qr, .qr-box canvas, #qrBox canvas");
  if(!canvas){alert("Primero genera el código QR.");return}
  try{
    const blob=await new Promise(resolve=>canvas.toBlob(resolve,"image/png"));
    if(!blob)throw new Error("QR_BLOB_FAILED");
    const file=new File([blob],"DONBEX-Radio-QR.png",{type:"image/png"});
    if(navigator.share && navigator.canShare && navigator.canShare({files:[file]})){
      await navigator.share({files:[file],title:"QR de mi Radio App"});
      return;
    }
    const url=URL.createObjectURL(blob);
    const a=document.createElement("a");
    a.href=url;a.download="DONBEX-Radio-QR.png";
    document.body.appendChild(a);a.click();a.remove();
    setTimeout(()=>URL.revokeObjectURL(url),1500);
  }catch(err){console.error("QR download",err);alert("No se pudo guardar el QR. Mantén pulsada la imagen para guardarla.");}
}
document.addEventListener("click",e=>{
  const b=e.target.closest("#downloadQr,#downloadQR,[data-download-qr]");
  if(!b)return;
  e.preventDefault();e.stopImmediatePropagation();donbexDownloadQR();
},true);


// ===== V17 TOUCH PHONE DETECTION =====
(()=>{
  const touchPhone=(navigator.maxTouchPoints||0)>0 && Math.min(screen.width,screen.height)<=900;
  if(touchPhone)document.documentElement.classList.add("touch-phone");
})();

let trackingCurrentOrder=null;
let trackingRenewPlan=null;

function fmtTrackingDate(v){
  if(!v)return "—";
  const raw=v?.toDate?v.toDate():new Date(v);
  return Number.isNaN(raw.getTime())?"—":raw.toLocaleDateString("es-EC",{year:"numeric",month:"short",day:"numeric"});
}

function renderTrackingView(order){
  trackingCurrentOrder=order;
  document.body.classList.add("tracking-mode");

  const isApproved=order.status==="approved";
  $("#trackingStationName").textContent=order.stationName||"Mi Radio Online";
  // SECURITY: never expose the public Radio URL before Admin approval.
  const onlinePending=order?.payment?.method==="paypal" && !isApproved && order.status!=="rejected";
  $("#trackingPublicUrl").textContent=isApproved
    ? (order.publicUrl||`https://radio.donbex.com/${order.slug||""}`)
    : onlinePending ? "Disponible al confirmar el pago" : "Disponible después de la aprobación";
  $("#trackingEditState").textContent=isApproved && order.editActive?"Activa":"No activa";
  $("#trackingEditExpiry").textContent=fmtTrackingDate(order.editExpiresAt);

  const onlineWaiting=onlinePending;
  const pill=$("#trackingStatusPill");
  pill.className="tracking-status-pill "+(order.status==="approved"?"approved":order.status==="rejected"?"rejected":"pending");
  pill.textContent=order.status==="approved"?"Activa":order.status==="rejected"?"Rechazada":onlineWaiting?"Pago pendiente":"En revisión";

  $("#trackingStateText").textContent=
    order.status==="approved"?"Radio App activada":
    order.status==="rejected"?"Solicitud rechazada":
    onlineWaiting?"Pago en línea no confirmado":"Pendiente de aprobación";

  $("#trackingIntroText").textContent=
    order.status==="approved"
      ?"Tu Radio App está activa. Aquí puedes abrirla, guardar el QR y contratar edición cuando necesites hacer cambios."
      :order.status==="rejected"
      ?"La solicitud fue revisada. Contacta a soporte si necesitas ayuda."
      :onlineWaiting
      ?"El panel se desbloqueará automáticamente cuando el pago en línea quede confirmado. Mientras tanto, el enlace público y el QR permanecen bloqueados."
      :"Recibimos tu comprobante. El enlace público, el QR y el acceso privado se habilitarán únicamente cuando la transferencia sea aprobada.";

  // SECURITY: approval controls are strictly gated by the request status.
  $("#trackingApprovedActions")?.classList.toggle("hidden",!isApproved);
  if(!isApproved){
    $("#trackingQrWrap")?.classList.add("hidden");
    $("#trackingInlineEditor")?.classList.add("hidden");
    $("#trackingInlineEditor")?.setAttribute("aria-hidden","true");
  }

  // Reuse the exact player already configured in the Studio.
  const device=document.querySelector(".preview-area .device");
  if(device){
    $("#trackingPlayerHost").appendChild(device);
  }

  if(order.radio){
    if(order.radio.template)setTemplate(order.radio.template);
    if(order.stationName){
      nameInput.value=order.stationName;
      namePreview.textContent=order.stationName;
    }
    if(order.radio.streamUrl)$("#streamUrl").value=order.radio.streamUrl;
    if(order.radio.instagram)$("#instagram").value=order.radio.instagram;
    if(order.radio.facebook)$("#facebook").value=order.radio.facebook;
    if(order.radio.tiktok)$("#tiktok").value=order.radio.tiktok;
  }

  if(order.logoUrl){
    logoPreview.src=order.logoUrl;
    logoPreview.style.display="block";
    logoFallback.style.display="none";
  }
  renderSocials();
}

window.addEventListener("donbex:tracking-loaded",e=>{
  renderTrackingView(e.detail.order);
},{capture:true});

document.addEventListener("click",async e=>{
  const planBtn=e.target.closest("[data-renew-plan]");
  if(planBtn){
    trackingRenewPlan={
      plan:planBtn.dataset.renewPlan,
      price:Number(planBtn.dataset.renewPrice||0)
    };
    document.querySelectorAll("[data-renew-plan]").forEach(b=>b.classList.toggle("active",b===planBtn));
    $("#trackingRequestEdit").disabled=false;
  }
});

$("#trackingOpenRadio")?.addEventListener("click",()=>{
  if(trackingCurrentOrder?.status!=="approved")return;
  if(trackingCurrentOrder?.publicUrl)location.href=trackingCurrentOrder.publicUrl;
});
$("#trackingCopyUrl")?.addEventListener("click",async()=>{
  if(trackingCurrentOrder?.status!=="approved")return;
  if(!trackingCurrentOrder?.publicUrl)return;
  await navigator.clipboard.writeText(trackingCurrentOrder.publicUrl);
  $("#trackingCopyUrl").textContent="Copiado ✓";
});
$("#trackingDownloadQr")?.addEventListener("click",()=>donbexDownloadQR());

$("#trackingRequestEdit")?.addEventListener("click",()=>{
  if(!trackingCurrentOrder||!trackingRenewPlan)return;
  window.dispatchEvent(new CustomEvent("donbex:open-edition-checkout",{
    detail:{order:trackingCurrentOrder,plan:trackingRenewPlan}
  }));
});


// ===== V18 ROBUST TRACKING QR =====
let trackingQrReady=false;

function loadImageForCanvas(url){
  return new Promise((resolve,reject)=>{
    if(!url){resolve(null);return}
    const img=new Image();
    img.crossOrigin="anonymous";
    img.onload=()=>resolve(img);
    img.onerror=reject;
    img.src=url;
  });
}

async function renderTrackingQR(order){
  const canvas=$("#trackingQrCanvas");
  if(!canvas||!window.QRCode||!order?.publicUrl)return;
  trackingQrReady=false;

  await new Promise((resolve,reject)=>{
    QRCode.toCanvas(canvas,order.publicUrl,{
      width:420,
      margin:3,
      errorCorrectionLevel:"H",
      color:{dark:"#000000",light:"#ffffff"}
    },err=>err?reject(err):resolve());
  });

  if(order.logoUrl){
    try{
      const img=await loadImageForCanvas(order.logoUrl);
      if(img){
        const ctx=canvas.getContext("2d");
        const size=Math.round(canvas.width*.19);
        const x=(canvas.width-size)/2,y=(canvas.height-size)/2;
        const pad=Math.round(size*.13);
        ctx.save();
        ctx.fillStyle="#fff";
        ctx.beginPath();
        if(ctx.roundRect)ctx.roundRect(x-pad,y-pad,size+pad*2,size+pad*2,14);
        else ctx.rect(x-pad,y-pad,size+pad*2,size+pad*2);
        ctx.fill();

        ctx.beginPath();
        ctx.arc(canvas.width/2,canvas.height/2,size/2,0,Math.PI*2);
        ctx.clip();
        ctx.drawImage(img,x,y,size,size);
        ctx.restore();
      }
    }catch(err){
      console.warn("QR logo overlay skipped",err);
    }
  }

  trackingQrReady=true;
  $("#trackingQrWrap")?.classList.remove("hidden");
}

async function saveTrackingQR(){
  const canvas=$("#trackingQrCanvas");
  if(!canvas||!trackingQrReady){
    alert("El QR todavía se está preparando. Inténtalo nuevamente en un segundo.");
    return;
  }

  const blob=await new Promise(resolve=>canvas.toBlob(resolve,"image/png"));
  if(!blob){
    alert("No se pudo preparar el QR.");
    return;
  }

  const name=((trackingCurrentOrder?.stationName||"radio")+"-QR.png").replace(/\s+/g,"-");
  const file=new File([blob],name,{type:"image/png"});

  // iPhone/iPad: Share sheet is the reliable path to Save Image / Files.
  if(navigator.share && navigator.canShare && navigator.canShare({files:[file]})){
    try{
      await navigator.share({files:[file],title:"QR de "+(trackingCurrentOrder?.stationName||"mi radio")});
      return;
    }catch(err){
      if(err?.name==="AbortError")return;
    }
  }

  const url=URL.createObjectURL(blob);
  const a=document.createElement("a");
  a.href=url;a.download=name;
  document.body.appendChild(a);a.click();a.remove();
  setTimeout(()=>URL.revokeObjectURL(url),2000);
}

// Capture to override old QR handlers.
document.addEventListener("click",e=>{
  const b=e.target.closest("#trackingDownloadQr,#downloadApprovedQr");
  if(!b)return;
  e.preventDefault();
  e.stopImmediatePropagation();
  saveTrackingQR();
},true);


// ===== DONBEX BRAND / HOW IT WORKS =====
const howModal=$("#howItWorksModal");
function openHow(){howModal?.classList.add("open");howModal?.setAttribute("aria-hidden","false");document.body.style.overflow="hidden"}
function closeHow(){howModal?.classList.remove("open");howModal?.setAttribute("aria-hidden","true");document.body.style.overflow=""}
$("#howItWorksBtn")?.addEventListener("click",openHow);
$("#closeHowItWorks")?.addEventListener("click",closeHow);
$("#howItWorksBackdrop")?.addEventListener("click",closeHow);
$("#bankHelpBtn")?.addEventListener("click",()=>{
  const subject=encodeURIComponent("Datos adicionales para transferencia — DONBEX Radio App");
  const body=encodeURIComponent("Hola, necesito información adicional para realizar una transferencia bancaria de DONBEX Radio App.");
  const configured=document.documentElement.dataset.supportEmail||"";
  if(configured.includes("@")) location.href=`mailto:${configured}?subject=${subject}&body=${body}`;
  else alert("El correo de soporte todavía no está configurado. Puedes completar el pago en línea o solicitar los datos al soporte de DONBEX.");
});

// ===== V18 EDITION CHECKOUT =====
let editionSelectedMethod="paypal", editionPaymentMethodChosen=false;

function openEditionCheckout(order,plan){
  trackingCurrentOrder=order;
  trackingRenewPlan=plan;
  editionSelectedMethod="paypal";
  editionPaymentMethodChosen=false;
  editionPaypalPendingOrder=null;
  editionPaypalButtonsRendered=false;

  const editionCard=$("#editionCheckout .edition-card");
  editionCard?.classList.remove("gateway-phase");
  document.querySelectorAll("[data-edition-method]").forEach(x=>x.classList.toggle("active",x.dataset.editionMethod==="paypal"));
  $("#editionPaypalInfo")?.classList.add("hidden");
  $("#editionBankInfo")?.classList.add("hidden");
  $("#editionForm")?.classList.add("hidden");
  $("#editionReceiptField")?.classList.add("hidden");
  $("#editionPaypalButtonContainer")?.classList.add("hidden");
  $("#editionPaypalButtonContainer")?.replaceChildren();
  if($("#editionPaypalState")) $("#editionPaypalState").textContent="Completa tus datos y pulsa “Continuar al pago”.";
  if($("#editionFormState")) $("#editionFormState").textContent="";
  const editionSubmit=$("#editionForm .edition-submit");
  if(editionSubmit){editionSubmit.disabled=false;editionSubmit.classList.remove("hidden");editionSubmit.textContent="Continuar al pago";}

  $("#editionStation").textContent=order.stationName||"Radio";
  $("#editionPlanLabel").textContent=plan.plan==="monthly"?"1 mes":plan.plan==="six"?"6 meses":"12 meses";
  $("#editionPlanPrice").textContent=`$${Number(plan.price).toFixed(2)}`;
  $("#editionCheckoutTitle").textContent="Activar edición por "+$("#editionPlanLabel").textContent;

  $("#editionCustomerName").value=order.customer?.name||"";
  $("#editionCustomerEmail").value=order.customer?.email||"";
  $("#editionCustomerWhatsapp").value=order.customer?.whatsapp||"";

  $("#editionCheckout").classList.remove("hidden");
  $("#editionCheckout").setAttribute("aria-hidden","false");
}

function closeEditionCheckout(){
  $("#editionCheckout .edition-card")?.classList.remove("gateway-phase");
  $("#editionForm")?.classList.remove("gateway-ready");
  $("#editionCheckout").classList.add("hidden");
  $("#editionCheckout").setAttribute("aria-hidden","true");
}
$("#closeEditionCheckout")?.addEventListener("click",closeEditionCheckout);
$("#editionBackdrop")?.addEventListener("click",closeEditionCheckout);

document.querySelectorAll("[data-edition-method]").forEach(btn=>btn.addEventListener("click",()=>{
  editionPaymentMethodChosen=true;
  editionSelectedMethod=btn.dataset.editionMethod;
  document.querySelectorAll("[data-edition-method]").forEach(x=>x.classList.toggle("active",x===btn));
  $("#editionCheckout .edition-card")?.classList.remove("gateway-phase");
  $("#editionPaypalButtonContainer")?.classList.add("hidden");
  $("#editionForm")?.classList.remove("hidden","gateway-ready");
  $("#editionPaypalInfo")?.classList.toggle("hidden",editionSelectedMethod!=="paypal");
  $("#editionBankInfo")?.classList.toggle("hidden",editionSelectedMethod!=="bank");
  $("#editionReceiptField")?.classList.toggle("hidden",editionSelectedMethod==="paypal");
  const er=$("#editionReceipt"); if(er) er.required=editionSelectedMethod==="bank";
  const eb=$("#editionForm .edition-submit");
  if(eb){eb.disabled=false;eb.textContent=editionSelectedMethod==="paypal"?"Continuar al pago":"Enviar comprobante y solicitar edición";eb.classList.remove("hidden");}
  if($("#editionPaypalState")) $("#editionPaypalState").textContent=editionSelectedMethod==="paypal"?"Completa tus datos y pulsa “Continuar al pago”.":"";
}));

window.addEventListener("donbex:open-edition-checkout",e=>{
  openEditionCheckout(e.detail.order,e.detail.plan);
});

$("#editionForm")?.addEventListener("submit",async e=>{
  e.preventDefault();
  if(!trackingCurrentOrder||!trackingRenewPlan||!editionPaymentMethodChosen)return;
  if(!e.currentTarget.reportValidity())return;

  const submit=e.currentTarget.querySelector(".edition-submit");
  submit.disabled=true;
  $("#editionFormState").textContent="";

  try{
    if(editionSelectedMethod==="paypal"){
      submit.textContent="Preparando pago seguro…";
      const token=(crypto.randomUUID?crypto.randomUUID():Math.random().toString(36).slice(2)+Date.now());
      editionPaypalPendingOrder={
        id:"EDT-"+Date.now(),
        requestType:"edition",
        trackingToken:token,
        trackingUrl:`https://radio.donbex.com/order/${token}`,
        stationName:trackingCurrentOrder.stationName||"Radio Online",
        slug:trackingCurrentOrder.slug,
        publicUrl:`https://radio.donbex.com/${trackingCurrentOrder.slug}`,
        privateEditUrl:trackingCurrentOrder.privateEditUrl||null,
        editToken:trackingCurrentOrder.editToken||null,
        customer:{name:$("#editionCustomerName").value.trim(),email:$("#editionCustomerEmail").value.trim(),whatsapp:$("#editionCustomerWhatsapp").value.trim()},
        payment:{method:"paypal",basePrice:0,editPlan:trackingRenewPlan.plan,editPrice:Number(trackingRenewPlan.price)||0,status:"pending"},
        status:"pending"
      };
      $("#editionForm")?.classList.add("gateway-ready");
      $("#editionCheckout .edition-card")?.classList.add("gateway-phase");
      await renderEditionPayPalButtons();
      $("#editionPaypalState").textContent="Elige PayPal o tarjeta para completar el pago seguro.";
      submit.classList.add("hidden");
      return;
    }

    const receiptFile=$("#editionReceipt").files?.[0];
    if(!receiptFile){$("#editionFormState").textContent="Selecciona tu comprobante.";submit.disabled=false;return}
    submit.textContent="Enviando solicitud…";
    const payload=await window.DONBEX_CREATE_EDITION_REQUEST({
      radio:{stationName:trackingCurrentOrder.stationName,slug:trackingCurrentOrder.slug,privateEditUrl:trackingCurrentOrder.privateEditUrl,editToken:trackingCurrentOrder.editToken},
      customer:{name:$("#editionCustomerName").value.trim(),email:$("#editionCustomerEmail").value.trim(),whatsapp:$("#editionCustomerWhatsapp").value.trim()},
      plan:trackingRenewPlan.plan,price:trackingRenewPlan.price,method:"bank",receiptFile
    });
    $("#editionFormState").textContent="Solicitud enviada. Quedó pendiente de aprobación.";
    submit.textContent="Solicitud enviada ✓";
    setTimeout(()=>{closeEditionCheckout();location.href=payload.trackingUrl},900);
  }catch(err){
    console.error(err);
    $("#editionCheckout .edition-card")?.classList.remove("gateway-phase");
    $("#editionForm")?.classList.remove("gateway-ready");
    $("#editionFormState").textContent="No se pudo preparar la solicitud.";
    submit.disabled=false;submit.classList.remove("hidden");submit.textContent=editionSelectedMethod==="paypal"?"Continuar al pago":"Enviar comprobante y solicitar edición";
  }
});

// ===== V18 PUBLIC PWA INSTALL =====
let deferredInstallPrompt=null;

function isIOSDevice(){
  const ua=navigator.userAgent||"";
  return /iPad|iPhone|iPod/.test(ua) || (navigator.platform==="MacIntel" && navigator.maxTouchPoints>1);
}
function isStandaloneMode(){
  return window.matchMedia("(display-mode: standalone)").matches || navigator.standalone===true;
}

window.addEventListener("beforeinstallprompt",e=>{
  e.preventDefault();
  deferredInstallPrompt=e;
  if(document.body.classList.contains("public-mode")&&!isStandaloneMode()){
    $("#publicInstallBtn")?.classList.remove("hidden");
  }
});

window.addEventListener("appinstalled",()=>{
  deferredInstallPrompt=null;
  $("#publicInstallBtn")?.classList.add("hidden");
});

function configurePublicInstall(radio){
  if(!radio||isStandaloneMode())return;

  const btn=$("#publicInstallBtn");
  if(isIOSDevice()){
    $("#publicInstallTitle").textContent="Instalar en iPhone";
    $("#publicInstallSubtitle").textContent="Añadir a pantalla de inicio";
    btn?.classList.remove("hidden");
  }else if(deferredInstallPrompt){
    $("#publicInstallTitle").textContent="Instalar Radio App";
    $("#publicInstallSubtitle").textContent="Instalar en este dispositivo";
    btn?.classList.remove("hidden");
  }

  // iOS uses this dynamically when user adds to home screen.
  if(radio.logoUrl){
    let apple=$("#dynamicAppleIcon");
    if(!apple){
      apple=document.createElement("link");
      apple.id="dynamicAppleIcon";
      apple.rel="apple-touch-icon";
      document.head.appendChild(apple);
    }
    apple.href=radio.logoUrl;
  }

  // Dynamic manifest for Android/Chromium with customer logo.
  const manifest=$("#dynamicManifest");
  if(manifest){
    const params=new URLSearchParams({
      name:radio.stationName||"Radio App",
      short_name:(radio.stationName||"Radio").slice(0,24),
      start_url:`/${radio.slug||""}`,
      icon:radio.logoUrl||""
    });
    manifest.href="/api/manifest?"+params.toString();
  }
}

$("#publicInstallBtn")?.addEventListener("click",async()=>{
  if(isIOSDevice()){
    $("#iosInstallSheet")?.classList.remove("hidden");
    return;
  }
  if(deferredInstallPrompt){
    deferredInstallPrompt.prompt();
    try{await deferredInstallPrompt.userChoice}catch{}
    deferredInstallPrompt=null;
    $("#publicInstallBtn").classList.add("hidden");
  }
});
$("#closeIosInstall")?.addEventListener("click",()=>$("#iosInstallSheet")?.classList.add("hidden"));
$("#iosInstallBackdrop")?.addEventListener("click",()=>$("#iosInstallSheet")?.classList.add("hidden"));

window.addEventListener("donbex:public-radio-loaded",e=>{
  configurePublicInstall(e.detail.radio);
},{capture:true});

// QR should render whenever tracking is loaded and approved.
window.addEventListener("donbex:tracking-loaded",e=>{
  if(e.detail.order?.status==="approved"){
    setTimeout(()=>renderTrackingQR(e.detail.order),0);
  }
},{capture:true});

if("serviceWorker" in navigator){
  window.addEventListener("load",()=>navigator.serviceWorker.register("/sw.js",{scope:"/"}).catch(console.error));
}


// ===== V18.1 STRICT PUBLIC-PWA SCOPE =====
function donbexIsPublicRadioRoute(){
  const path=location.pathname.replace(/^\/+|\/+$/g,"");
  if(!path)return false;
  if(path==="index.html")return false;
  if(path.startsWith("order/"))return false;
  if(path.startsWith("edit/"))return false;
  if(path.startsWith("api/"))return false;
  return path.split("/").length===1;
}

// At Studio root, tracking, edit, or any non-public route: installation UI must never appear.
if(!donbexIsPublicRadioRoute()){
  $("#publicInstallBtn")?.classList.add("hidden");
  $("#iosInstallSheet")?.classList.add("hidden");
}

// Guard the public install event even if another event fires unexpectedly.
window.addEventListener("donbex:public-radio-loaded",e=>{
  if(!donbexIsPublicRadioRoute()){
    $("#publicInstallBtn")?.classList.add("hidden");
    $("#iosInstallSheet")?.classList.add("hidden");
    return;
  }
},{capture:true});

// Force-close iPhone instructions reliably.
function closeDonbexIosInstall(){
  const sheet=$("#iosInstallSheet");
  if(sheet)sheet.classList.add("hidden");
}
$("#closeIosInstall")?.addEventListener("click",e=>{
  e.preventDefault();
  e.stopPropagation();
  closeDonbexIosInstall();
},{capture:true});
$("#iosInstallBackdrop")?.addEventListener("click",e=>{
  e.preventDefault();
  closeDonbexIosInstall();
},{capture:true});

// Escape key also closes the instructions.
document.addEventListener("keydown",e=>{
  if(e.key==="Escape")closeDonbexIosInstall();
});


// ===== V19 TRACKING: EDIT BUTTON + RELIABLE QR =====
function trackingEditIsActive(order){
  if(!order?.editActive)return false;
  if(!order?.editExpiresAt)return true;
  const d=order.editExpiresAt?.toDate?order.editExpiresAt.toDate():new Date(order.editExpiresAt);
  return !Number.isNaN(d.getTime()) && d.getTime()>Date.now();
}

function updateTrackingEditButton(order){
  const btn=$("#trackingEditRadio");
  if(!btn)return;
  const active=order?.status==="approved" && trackingEditIsActive(order);
  btn.classList.toggle("hidden",!active);
  if(active){
    btn.textContent="Editar mi radio";
  }
}

$("#trackingEditRadio")?.addEventListener("click",()=>{
  if(trackingCurrentOrder?.privateEditUrl){
    location.href=trackingCurrentOrder.privateEditUrl;
  }
});

window.addEventListener("donbex:tracking-loaded",e=>{
  updateTrackingEditButton(e.detail.order);
},{capture:true});

async function renderTrackingQRV19(order){
  const canvas=$("#trackingQrCanvas");
  const image=$("#trackingQrImage");
  if(!canvas||!window.QRCode||!order?.publicUrl)return;

  trackingQrReady=false;

  await new Promise((resolve,reject)=>{
    QRCode.toCanvas(canvas,order.publicUrl,{
      width:420,
      margin:3,
      errorCorrectionLevel:"H",
      color:{dark:"#000000",light:"#ffffff"}
    },err=>err?reject(err):resolve());
  });

  if(order.logoUrl){
    try{
      const img=await loadImageForCanvas(order.logoUrl);
      if(img){
        const ctx=canvas.getContext("2d");
        const size=Math.round(canvas.width*.18);
        const x=(canvas.width-size)/2,y=(canvas.height-size)/2;
        const pad=Math.round(size*.14);
        ctx.save();
        ctx.fillStyle="#fff";
        ctx.fillRect(x-pad,y-pad,size+pad*2,size+pad*2);
        ctx.beginPath();
        ctx.arc(canvas.width/2,canvas.height/2,size/2,0,Math.PI*2);
        ctx.clip();
        ctx.drawImage(img,x,y,size,size);
        ctx.restore();
      }
    }catch(err){console.warn("QR logo skipped",err)}
  }

  const dataUrl=canvas.toDataURL("image/png");
  if(image)image.src=dataUrl;
  trackingQrReady=true;
  $("#trackingQrWrap")?.classList.remove("hidden");
}

window.addEventListener("donbex:tracking-loaded",e=>{
  if(e.detail.order?.status==="approved"){
    setTimeout(()=>renderTrackingQRV19(e.detail.order),50);
  }
},{capture:true});

async function saveTrackingQRV19(){
  const canvas=$("#trackingQrCanvas");
  const image=$("#trackingQrImage");
  if(!canvas || !trackingQrReady){
    alert("El QR todavía se está preparando. Inténtalo nuevamente en un segundo.");
    return;
  }

  let blob = await new Promise(resolve=>canvas.toBlob(resolve,"image/png"));
  if(!blob && image?.src?.startsWith("data:image/png")){
    const res=await fetch(image.src);
    blob=await res.blob();
  }
  if(!blob){
    alert("No se pudo preparar el QR.");
    return;
  }

  const name=((trackingCurrentOrder?.stationName||"radio")+"-QR.png").replace(/\s+/g,"-");
  const file=new File([blob],name,{type:"image/png"});

  if(navigator.share && navigator.canShare && navigator.canShare({files:[file]})){
    try{
      await navigator.share({files:[file],title:"QR de "+(trackingCurrentOrder?.stationName||"mi radio")});
      return;
    }catch(err){
      if(err?.name==="AbortError")return;
    }
  }

  const url=URL.createObjectURL(blob);
  const a=document.createElement("a");
  a.href=url;
  a.download=name;
  document.body.appendChild(a);
  a.click();
  a.remove();
  setTimeout(()=>URL.revokeObjectURL(url),2500);
}

document.addEventListener("click",e=>{
  const b=e.target.closest("#trackingDownloadQr,#downloadApprovedQr");
  if(!b)return;
  e.preventDefault();
  e.stopImmediatePropagation();
  saveTrackingQRV19();
},true);

// ===== V19 PUBLIC PWA ROUTE-LOCK =====
window.addEventListener("donbex:public-radio-loaded",e=>{
  // public install is only configured for the loaded station
  configurePublicInstall(e.detail.radio);
},{capture:true});


// ===== FINAL: OLD /edit LINKS ALWAYS RETURN TO THE PRIVATE TRACKING HUB =====
window.addEventListener("donbex:edit-access-loaded",e=>{
  const access=e.detail?.access||{};
  if(!/^\/edit\//.test(location.pathname))return;

  const target =
    access.trackingUrl ||
    (access.requestId ? `/order/${access.requestId}` : null);

  if(target){
    location.replace(target);
  }
},{capture:true});

// ===== V19 EDIT ROUTE =====
window.addEventListener("donbex:edit-access-loaded",e=>{
  const access=e.detail.access;
  const expires=access.editExpiresAt?.toDate?access.editExpiresAt.toDate():new Date(access.editExpiresAt||0);
  const active=access.editActive && (!access.editExpiresAt || expires.getTime()>Date.now());

  if(!active){
    alert("Tu período de edición no está activo.");
    location.href=`/order/${access.requestId||""}`;
    return;
  }

  document.documentElement.classList.add("route-edit");
  document.body.classList.remove("tracking-mode","public-mode");

  // Fetch current radio config using slug from edit access.
  if(access.slug){
    window.dispatchEvent(new CustomEvent("donbex:load-edit-radio",{detail:{slug:access.slug,access}}));
  }
});


window.addEventListener("donbex:edit-radio-loaded",e=>{
  const radio=e.detail.radio;
  if(radio.stationName){
    nameInput.value=radio.stationName;
    namePreview.textContent=radio.stationName;
  }
  $("#streamUrl").value=radio.streamUrl||"";
  $("#instagram").value=radio.instagram||"";
  $("#facebook").value=radio.facebook||"";
  $("#tiktok").value=radio.tiktok||"";
  if(radio.logoUrl){
    logoPreview.src=radio.logoUrl;
    logoPreview.style.display="block";
    logoFallback.style.display="none";
  }
  setTemplate(radio.template||"orbit");
  renderSocials();

  // Repurpose primary button for save when in edit mode.
  const save=$("#generate");
  if(save){
    save.style.display="block";
    save.textContent="Guardar cambios";
    save.onclick=async ev=>{
      ev.preventDefault();
      window.dispatchEvent(new CustomEvent("donbex:save-edit-radio",{
        detail:{
          slug:radio.slug,
          stationName:nameInput.value.trim(),
          streamUrl:$("#streamUrl").value.trim(),
          instagram:$("#instagram").value.trim(),
          facebook:$("#facebook").value.trim(),
          tiktok:$("#tiktok").value.trim(),
          template:currentTemplate,
          logoFile:$("#logoInput").files?.[0]||null,
          currentLogoUrl:radio.logoUrl||null
        }
      }));
    };
  }
});

window.addEventListener("donbex:edit-radio-saved",e=>{
  alert("Cambios guardados correctamente.");
  if(e.detail?.trackingUrl)location.href=e.detail.trackingUrl;
});


// ===== V20 FINAL QR + IPHONE PWA START URL =====

// Always use a same-origin proxy for the customer logo when drawing it into a QR.
// This prevents the canvas from becoming "tainted" and therefore fixes white/unsavable QR output.
async function renderTrackingQRV20(order){
  const canvas=$("#trackingQrCanvas");
  const image=$("#trackingQrImage");
  if(!canvas||!window.QRCode||!order?.publicUrl)return;

  trackingQrReady=false;

  await new Promise((resolve,reject)=>{
    QRCode.toCanvas(canvas,order.publicUrl,{
      width:420,
      margin:3,
      errorCorrectionLevel:"H",
      color:{dark:"#000000",light:"#ffffff"}
    },err=>err?reject(err):resolve());
  });

  if(order.logoUrl){
    try{
      const proxied="/api/logo-proxy?url="+encodeURIComponent(order.logoUrl);
      const logo=await loadImageForCanvas(proxied);
      if(logo){
        const ctx=canvas.getContext("2d");
        const size=Math.round(canvas.width*.18);
        const x=(canvas.width-size)/2;
        const y=(canvas.height-size)/2;
        const pad=Math.round(size*.14);

        ctx.save();
        ctx.fillStyle="#ffffff";
        ctx.fillRect(x-pad,y-pad,size+pad*2,size+pad*2);
        ctx.beginPath();
        ctx.arc(canvas.width/2,canvas.height/2,size/2,0,Math.PI*2);
        ctx.clip();
        ctx.drawImage(logo,x,y,size,size);
        ctx.restore();
      }
    }catch(err){
      console.error("QR logo proxy failed",err);
    }
  }

  // Validate that the final canvas is exportable before marking it ready.
  const dataUrl=canvas.toDataURL("image/png");
  if(!dataUrl.startsWith("data:image/png")){
    throw new Error("QR_EXPORT_FAILED");
  }

  if(image)image.src=dataUrl;
  trackingQrReady=true;
  $("#trackingQrWrap")?.classList.remove("hidden");
}

window.addEventListener("donbex:tracking-loaded",e=>{
  if(e.detail.order?.status==="approved"){
    setTimeout(()=>{
      renderTrackingQRV20(e.detail.order).catch(err=>{
        console.error("QR V20 render error",err);
        trackingQrReady=false;
      });
    },80);
  }
},{capture:true});

async function saveTrackingQRV20(){
  const canvas=$("#trackingQrCanvas");
  if(!canvas){
    alert("No encontramos el QR.");
    return;
  }

  // If it was not ready yet, render it synchronously now.
  if(!trackingQrReady && trackingCurrentOrder?.status==="approved"){
    try{
      await renderTrackingQRV20(trackingCurrentOrder);
    }catch(err){
      console.error(err);
    }
  }

  if(!trackingQrReady){
    alert("No se pudo preparar el QR.");
    return;
  }

  const blob=await new Promise(resolve=>canvas.toBlob(resolve,"image/png"));
  if(!blob){
    alert("No se pudo preparar el archivo QR.");
    return;
  }

  const name=((trackingCurrentOrder?.stationName||"radio")+"-QR.png").replace(/\s+/g,"-");
  const file=new File([blob],name,{type:"image/png"});

  if(navigator.share && navigator.canShare && navigator.canShare({files:[file]})){
    try{
      await navigator.share({files:[file],title:"QR de "+(trackingCurrentOrder?.stationName||"mi radio")});
      return;
    }catch(err){
      if(err?.name==="AbortError")return;
    }
  }

  const url=URL.createObjectURL(blob);
  const a=document.createElement("a");
  a.href=url;
  a.download=name;
  document.body.appendChild(a);
  a.click();
  a.remove();
  setTimeout(()=>URL.revokeObjectURL(url),2500);
}

document.addEventListener("click",e=>{
  const b=e.target.closest("#trackingDownloadQr,#downloadApprovedQr");
  if(!b)return;
  e.preventDefault();
  e.stopImmediatePropagation();
  saveTrackingQRV20();
},true);

// Public PWA metadata is generated ONLY after a real published station has loaded.
function installPublicRadioMetadata(radio){
  if(!radio||!donbexIsPublicRadioRoute())return;

  const title=radio.stationName||"Radio App";
  document.title=title;

  let appleTitle=document.querySelector('meta[name="apple-mobile-web-app-title"]');
  if(!appleTitle){
    appleTitle=document.createElement("meta");
    appleTitle.name="apple-mobile-web-app-title";
    document.head.appendChild(appleTitle);
  }
  appleTitle.content=title;

  if(radio.logoUrl){
    let appleIcon=$("#dynamicAppleIcon");
    if(!appleIcon){
      appleIcon=document.createElement("link");
      appleIcon.id="dynamicAppleIcon";
      appleIcon.rel="apple-touch-icon";
      document.head.appendChild(appleIcon);
    }
    appleIcon.href=radio.logoUrl;
  }

  // iPhone: deliberately NO manifest. Safari then saves the CURRENT station URL,
  // rather than the Studio's old "/" start_url.
  if(isIOSDevice()){
    document.querySelector('link[rel="manifest"]')?.remove();
    return;
  }

  // Android/Chromium: inject a station-specific manifest only on the public radio route.
  let manifest=document.querySelector('link[rel="manifest"]');
  if(!manifest){
    manifest=document.createElement("link");
    manifest.rel="manifest";
    document.head.appendChild(manifest);
  }
  const params=new URLSearchParams({
    name:title,
    short_name:title.slice(0,24),
    start_url:location.pathname,
    icon:radio.logoUrl||""
  });
  manifest.href="/api/manifest?"+params.toString();
}

window.addEventListener("donbex:public-radio-loaded",e=>{
  installPublicRadioMetadata(e.detail.radio);
},{capture:true});


// ===== V21 PRIVATE HUB + SERVER QR =====
function privateHubUrlFromOrder(order){
  return order?.trackingUrl || (order?.trackingToken ? `/order/${order.trackingToken}` : null);
}

function showPrivateHubBack(url){
  const b=$("#privateHubBack");
  if(!b||!url)return;
  b.dataset.url=url;
  b.classList.remove("hidden");
}
$("#privateHubBack")?.addEventListener("click",()=>{
  const u=$("#privateHubBack")?.dataset.url;
  if(u)location.href=u;
});

// Public player gets a back button only when opened from its private tracking hub in same tab.
$("#trackingOpenRadio")?.addEventListener("click",()=>{
  if(trackingCurrentOrder?.publicUrl){
    sessionStorage.setItem("donbex_private_hub",trackingCurrentOrder.trackingUrl||"");
    location.href=trackingCurrentOrder.publicUrl;
  }
},{capture:true});

if(donbexIsPublicRadioRoute()){
  const hub=sessionStorage.getItem("donbex_private_hub");
  if(hub)showPrivateHubBack(hub);
}

window.addEventListener("donbex:edit-access-loaded",e=>{
  const access=e.detail.access;
  const hub=access.requestId ? `/order/${access.requestId}` : document.referrer;
  if(hub)showPrivateHubBack(hub);
},{capture:true});

// Server-generated QR URL. No canvas readiness dependency.
function qrPngUrl(order){
  if(!order?.publicUrl)return null;
  const q=new URLSearchParams({url:order.publicUrl});
  if(order.logoUrl)q.set("logo",order.logoUrl);
  return "/api/qr?"+q.toString();
}

window.addEventListener("donbex:tracking-loaded",e=>{
  const order=e.detail.order;
  if(order?.status!=="approved")return;
  const url=qrPngUrl(order);
  const wrap=$("#trackingQrWrap");
  const img=$("#trackingQrImage");
  const canvas=$("#trackingQrCanvas");

  if(canvas)canvas.style.display="none";
  if(img && url){
    img.classList.remove("hidden");
    img.style.display="block";
    img.style.width="min(260px,100%)";
    img.style.height="auto";
    img.style.margin="0 auto";
    img.style.background="#fff";
    img.style.padding="10px";
    img.style.borderRadius="14px";
    img.src=url;
  }
  wrap?.classList.remove("hidden");
},{capture:true});

async function saveServerQR(){
  const order=trackingCurrentOrder;
  const url=qrPngUrl(order);
  if(!url){
    alert("No encontramos el QR.");
    return;
  }
  try{
    const r=await fetch(url,{cache:"no-store"});
    if(!r.ok)throw new Error("QR_HTTP_"+r.status);
    const blob=await r.blob();
    const name=((order?.stationName||"radio")+"-QR.png").replace(/\s+/g,"-");
    const file=new File([blob],name,{type:"image/png"});

    if(navigator.share && navigator.canShare && navigator.canShare({files:[file]})){
      try{
        await navigator.share({files:[file],title:"QR de "+(order?.stationName||"mi radio")});
        return;
      }catch(err){
        if(err?.name==="AbortError")return;
      }
    }

    const local=URL.createObjectURL(blob);
    const a=document.createElement("a");
    a.href=local;a.download=name;
    document.body.appendChild(a);a.click();a.remove();
    setTimeout(()=>URL.revokeObjectURL(local),2500);
  }catch(err){
    console.error(err);
    // Last-resort: open PNG itself, allowing long-press Save Image on iPhone.
    location.href=url;
  }
}

document.addEventListener("click",e=>{
  const b=e.target.closest("#trackingDownloadQr,#downloadApprovedQr");
  if(!b)return;
  e.preventDefault();
  e.stopImmediatePropagation();
  saveServerQR();
},true);

// When already installed/standalone, never show install bubble.
if(isStandaloneMode()){
  $("#publicInstallBtn")?.classList.add("hidden");
  $("#iosInstallSheet")?.classList.add("hidden");
}


// ===== V22 QR DOWNLOAD OVERRIDE =====
// This runs on WINDOW capture, before every older document click handler.
window.addEventListener("click",async e=>{
  const btn=e.target.closest?.("#trackingDownloadQr,#downloadApprovedQr");
  if(!btn)return;

  e.preventDefault();
  e.stopImmediatePropagation();

  const order=trackingCurrentOrder||window.__DONBEX_LAST_ORDER__;
  if(!order?.publicUrl){
    alert("No encontramos el enlace público de esta radio.");
    return;
  }

  const q=new URLSearchParams({url:order.publicUrl});
  if(order.logoUrl)q.set("logo",order.logoUrl);
  const endpoint="/api/qr?"+q.toString();

  try{
    btn.disabled=true;
    const original=btn.textContent;
    btn.textContent="Descargando…";

    const r=await fetch(endpoint,{cache:"no-store"});
    if(!r.ok)throw new Error("QR_HTTP_"+r.status);
    const blob=await r.blob();
    const name=((order.stationName||"radio")+"-QR.png").replace(/\s+/g,"-");
    const file=new File([blob],name,{type:"image/png"});

    if(navigator.share && navigator.canShare && navigator.canShare({files:[file]})){
      try{
        await navigator.share({files:[file],title:"QR de "+(order.stationName||"mi radio")});
      }catch(err){
        if(err?.name!=="AbortError")throw err;
      }
    }else{
      const local=URL.createObjectURL(blob);
      const a=document.createElement("a");
      a.href=local;a.download=name;
      document.body.appendChild(a);a.click();a.remove();
      setTimeout(()=>URL.revokeObjectURL(local),2500);
    }
    btn.textContent=original;
    btn.disabled=false;
  }catch(err){
    console.error(err);
    btn.disabled=false;
    btn.textContent="Descargar QR";
    window.open(endpoint,"_blank","noopener");
  }
},true);

// ===== V22 EDITOR BOOTSTRAP =====
function editTokenFromCurrentPath(){
  const m=location.pathname.match(/^\/edit\/([^/]+)/);
  return m?decodeURIComponent(m[1]):null;
}

// Ensure the editor shell is visible immediately on /edit.
if(editTokenFromCurrentPath()){
  document.documentElement.classList.add("route-edit");
  document.body?.classList.remove("public-mode","tracking-mode");
}

// When access arrives, remember the canonical private panel URL when available.
window.addEventListener("donbex:edit-access-loaded",e=>{
  const access=e.detail.access||{};
  const hub=access.trackingUrl || sessionStorage.getItem("donbex_private_hub") || document.referrer;
  if(hub && /\/order\//.test(hub))showPrivateHubBack(hub);
},{capture:true});

window.addEventListener("donbex:edit-radio-updated",e=>{
  const save=$("#generate");
  if(save){
    save.disabled=false;
    save.textContent="Cambios guardados ✓";
    setTimeout(()=>save.textContent="Guardar cambios",1400);
  }
  alert("Cambios guardados. La misma Radio App, enlace y QR se mantienen.");
});
window.addEventListener("donbex:edit-radio-update-error",()=>{
  const save=$("#generate");
  if(save){save.disabled=false;save.textContent="Guardar cambios";}
  alert("No se pudieron guardar los cambios.");
});


// ===== V23 INLINE EDITOR ON TRACKING PAGE =====
let inlineOriginal=null;
let inlineLogoObjectUrl=null;

function inlineCurrentOrder(){
  return trackingCurrentOrder||window.__DONBEX_LAST_ORDER__||null;
}

function populateInlineEditor(order){
  const radio=order?.radio||{};
  $("#inlineStationName").value=order?.stationName||"";
  $("#inlineStreamUrl").value=radio.streamUrl||"";
  $("#inlineTemplate").value=radio.template||"orbit";
  $("#inlineInstagram").value=radio.instagram||"";
  $("#inlineFacebook").value=radio.facebook||"";
  $("#inlineTiktok").value=radio.tiktok||"";
  $("#inlineLogo").value="";
  $("#inlineEditState").textContent="";
  inlineOriginal={
    stationName:order?.stationName||"",
    streamUrl:radio.streamUrl||"",
    template:radio.template||"orbit",
    instagram:radio.instagram||"",
    facebook:radio.facebook||"",
    tiktok:radio.tiktok||"",
    logoUrl:order?.logoUrl||null
  };
}

function openInlineEditor(){
  const order=inlineCurrentOrder();
  // SECURITY: inline editing is unavailable until Admin approval.
  if(!order || order.status!=="approved")return;
  populateInlineEditor(order);
  $("#trackingInlineEditor").classList.remove("hidden");
  $("#trackingInlineEditor").setAttribute("aria-hidden","false");
  $("#trackingInlineEditor").scrollIntoView({behavior:"smooth",block:"nearest"});
}

function closeInlineEditor(){
  $("#trackingInlineEditor").classList.add("hidden");
  $("#trackingInlineEditor").setAttribute("aria-hidden","true");
  $("#inlineEditState").textContent="";
  if(inlineLogoObjectUrl){
    URL.revokeObjectURL(inlineLogoObjectUrl);
    inlineLogoObjectUrl=null;
  }
}

// Override the old navigation behavior: edit is now in this same private panel.
window.addEventListener("click",e=>{
  const btn=e.target.closest?.("#trackingEditRadio");
  if(!btn)return;
  e.preventDefault();
  e.stopImmediatePropagation();
  openInlineEditor();
},true);

$("#closeTrackingEditor")?.addEventListener("click",closeInlineEditor);
$("#cancelInlineEdit")?.addEventListener("click",()=>{
  if(inlineOriginal)applyInlinePreview(inlineOriginal);
  closeInlineEditor();
});

function applyInlinePreview(data){
  try{
    if(data.stationName){
      nameInput.value=data.stationName;
      namePreview.textContent=data.stationName;
    }
    if(typeof data.streamUrl==="string")$("#streamUrl").value=data.streamUrl;
    if(typeof data.instagram==="string")$("#instagram").value=data.instagram;
    if(typeof data.facebook==="string")$("#facebook").value=data.facebook;
    if(typeof data.tiktok==="string")$("#tiktok").value=data.tiktok;

    if(data.template && typeof setTemplate==="function")setTemplate(data.template);
    if(typeof renderSocials==="function")renderSocials();

    if(data.logoUrl){
      logoPreview.src=data.logoUrl;
      logoPreview.style.display="block";
      logoFallback.style.display="none";
    }
  }catch(err){console.warn("Inline preview update",err)}
}

function liveInlineData(){
  return {
    stationName:$("#inlineStationName").value.trim(),
    streamUrl:$("#inlineStreamUrl").value.trim(),
    template:$("#inlineTemplate").value,
    instagram:$("#inlineInstagram").value.trim(),
    facebook:$("#inlineFacebook").value.trim(),
    tiktok:$("#inlineTiktok").value.trim()
  };
}

["inlineStationName","inlineStreamUrl","inlineTemplate","inlineInstagram","inlineFacebook","inlineTiktok"].forEach(id=>{
  $("#"+id)?.addEventListener("input",()=>applyInlinePreview(liveInlineData()));
  $("#"+id)?.addEventListener("change",()=>applyInlinePreview(liveInlineData()));
});

$("#inlineLogo")?.addEventListener("change",e=>{
  const file=e.target.files?.[0];
  if(!file)return;
  if(inlineLogoObjectUrl)URL.revokeObjectURL(inlineLogoObjectUrl);
  inlineLogoObjectUrl=URL.createObjectURL(file);
  applyInlinePreview({...liveInlineData(),logoUrl:inlineLogoObjectUrl});
});

$("#saveInlineEdit")?.addEventListener("click",()=>{
  const order=inlineCurrentOrder();
  if(!order?.editToken){
    $("#inlineEditState").textContent="No encontramos tu acceso de edición.";
    return;
  }
  const changes=liveInlineData();
  const file=$("#inlineLogo").files?.[0]||null;

  const btn=$("#saveInlineEdit");
  btn.disabled=true;
  btn.textContent="Guardando…";
  $("#inlineEditState").textContent="Actualizando tu Radio App…";

  window.dispatchEvent(new CustomEvent("donbex:inline-edit-save",{
    detail:{
      editToken:order.editToken,
      slug:order.slug,
      currentLogoUrl:order.logoUrl||null,
      logoFile:file,
      changes
    }
  }));
});

window.addEventListener("donbex:inline-edit-saved",e=>{
  const btn=$("#saveInlineEdit");
  btn.disabled=false;
  btn.textContent="Guardar cambios";
  $("#inlineEditState").textContent="Cambios guardados ✓";

  const result=e.detail||{};
  const order=inlineCurrentOrder();
  if(order){
    order.stationName=result.stationName||$("#inlineStationName").value.trim()||order.stationName;
    order.logoUrl=result.logoUrl||order.logoUrl;
    order.radio={
      ...(order.radio||{}),
      ...liveInlineData()
    };
    trackingCurrentOrder=order;
  }

  setTimeout(closeInlineEditor,700);
});

window.addEventListener("donbex:inline-edit-error",()=>{
  const btn=$("#saveInlineEdit");
  btn.disabled=false;
  btn.textContent="Guardar cambios";
  $("#inlineEditState").textContent="No se pudieron guardar los cambios.";
});

// ===== V23 TRUE QR DOWNLOAD =====
// No Share Sheet. Download the already-generated server PNG as an attachment.
window.addEventListener("click",e=>{
  const btn=e.target.closest?.("#trackingDownloadQr,#downloadApprovedQr");
  if(!btn)return;
  e.preventDefault();
  e.stopImmediatePropagation();

  const order=inlineCurrentOrder();
  if(!order?.publicUrl){
    alert("No encontramos el enlace público de esta radio.");
    return;
  }

  const q=new URLSearchParams({url:order.publicUrl,download:"1"});
  if(order.logoUrl)q.set("logo",order.logoUrl);

  const a=document.createElement("a");
  a.href="/api/qr?"+q.toString();
  a.download=((order.stationName||"radio")+"-QR.png").replace(/\s+/g,"-");
  document.body.appendChild(a);
  a.click();
  a.remove();
},true);


// ===== PAYPAL SANDBOX/LIVE — secure server-side order creation/capture =====

// ===== DONBEX PAYPAL REDIRECT RETURN =====
async function handlePayPalRedirectReturn(){
  const q=new URLSearchParams(location.search);
  const tracking=q.get("tracking");
  const paypalOrderId=q.get("token");
  if(q.get("paypal_cancel")==="1"){
    history.replaceState({},"",location.pathname);
    setTimeout(()=>{
      if(typeof openCheckout==="function")openCheckout();
      const state=$("#paypalState"); if(state)state.textContent="Pago cancelado. Puedes intentarlo nuevamente o elegir transferencia.";
    },80);
    return;
  }
  if(q.get("paypal_return")!=="1"||!tracking||!paypalOrderId)return;
  document.documentElement.classList.add("paypal-returning");
  try{
    const r=await fetch("/api/paypal-capture-order",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({trackingToken:tracking,paypalOrderId})});
    const j=await r.json();
    if(!r.ok)throw new Error(j.error||"No se pudo confirmar el pago");
    location.replace(j.trackingUrl||`/order/${encodeURIComponent(tracking)}`);
  }catch(err){
    console.error(err);
    history.replaceState({},"",location.pathname);
    setTimeout(()=>{
      if(typeof openCheckout==="function")openCheckout();
      const state=$("#paypalState"); if(state)state.textContent="El pago regresó de PayPal, pero no pudimos confirmarlo todavía. No vuelvas a pagar; revisaremos la transacción.";
    },80);
  }
}
handlePayPalRedirectReturn();

let paypalSdkReady=false, paypalButtonsRendered=false, paypalPendingOrder=null;
async function loadPayPalSdk(){
  if(paypalSdkReady && window.paypal)return true;
  const cfg=await fetch("/api/paypal-config",{cache:"no-store"}).then(r=>r.json());
  if(!cfg.clientId)throw new Error("PayPal Client ID not configured");
  await new Promise((resolve,reject)=>{
    const existing=document.querySelector('script[data-donbex-paypal]');
    if(existing){existing.addEventListener("load",resolve,{once:true});existing.addEventListener("error",reject,{once:true});return}
    const s=document.createElement("script");
    const lang=(navigator.language||document.documentElement.lang||"es").toLowerCase();
    const locale=lang.startsWith("en")?"en_US":"es_EC";
    s.dataset.donbexPaypal="1";
    s.src=`https://www.paypal.com/sdk/js?client-id=${encodeURIComponent(cfg.clientId)}&currency=USD&intent=capture&locale=${locale}`;
    s.onload=resolve;s.onerror=reject;document.head.appendChild(s);
  });
  paypalSdkReady=!!window.paypal; return paypalSdkReady;
}
async function renderPayPalButtons(){
  $("#paypalButtonContainer")?.classList.remove("hidden");
  $("#paypalState")?.classList.remove("hidden");
  if(paypalButtonsRendered)return;
  try{
    await loadPayPalSdk();
    await window.paypal.Buttons({
      style:{layout:"vertical",shape:"rect",label:"paypal"},
      createOrder:async()=>{
        if(!paypalPendingOrder)throw new Error("Completa tus datos primero");
        const r=await fetch("/api/paypal-create-order",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({order:paypalPendingOrder})});
        const data=await r.json();if(!r.ok)throw new Error(data.error||"No se pudo crear el pago");
        const expected=Number((BASE_PRICE+Number(paypalPendingOrder?.payment?.editPrice||0)).toFixed(2));
        if(data.amount!=null && Math.abs(Number(data.amount)-expected)>.001)throw new Error("El total de PayPal no coincide con la selección del cliente");
        return data.id;
      },
      onApprove:async data=>{
        $("#paypalState").textContent="Confirmando pago seguro…";
        const r=await fetch("/api/paypal-capture-order",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({trackingToken:paypalPendingOrder.trackingToken,paypalOrderId:data.orderID})});
        const out=await r.json();if(!r.ok)throw new Error(out.error||"No se pudo confirmar el pago");
        $("#paypalState").textContent="Pago exitoso ✓ Tu Radio App fue activada. Abriendo tu panel privado de seguimiento…";
        setTimeout(()=>{ location.href=paypalPendingOrder.trackingUrl; },650);
      },
      onCancel:()=>{$("#paypalState").textContent="Pago cancelado. Puedes intentarlo nuevamente."},
      onError:err=>{console.error(err);$("#paypalState").textContent="No se pudo completar el pago en línea. Inténtalo nuevamente."}
    }).render("#paypalButtonContainer");
    paypalButtonsRendered=true;
  }catch(err){console.warn("PayPal unavailable",err);$("#paypalState").textContent="El pago en línea todavía no está configurado en este entorno. Puedes usar transferencia bancaria mientras se conectan las credenciales."}
}
window.addEventListener("donbex:paypal-start",async e=>{paypalPendingOrder=e.detail.order;await renderPayPalButtons()});


let editionPaypalPendingOrder=null, editionPaypalButtonsRendered=false;
async function renderEditionPayPalButtons(){
  $("#editionPaypalButtonContainer")?.classList.remove("hidden");
  if(editionPaypalButtonsRendered)return;
  try{
    await loadPayPalSdk();
    await window.paypal.Buttons({
      style:{layout:"vertical",shape:"rect",label:"paypal"},
      createOrder:async()=>{
        if(!editionPaypalPendingOrder)throw new Error("Completa tus datos primero");
        const r=await fetch("/api/paypal-create-order",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({order:editionPaypalPendingOrder})});
        const data=await r.json();if(!r.ok)throw new Error(data.error||"No se pudo crear el pago");return data.id;
      },
      onApprove:async data=>{
        $("#editionPaypalState").textContent="Confirmando pago…";
        const r=await fetch("/api/paypal-capture-order",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({trackingToken:editionPaypalPendingOrder.trackingToken,paypalOrderId:data.orderID})});
        const out=await r.json();if(!r.ok)throw new Error(out.error||"No se pudo confirmar el pago");
        $("#editionPaypalState").textContent="Pago confirmado ✓ Edición activada.";
        location.href=editionPaypalPendingOrder.trackingUrl;
      },
      onCancel:()=>{$("#editionPaypalState").textContent="Pago cancelado. Puedes intentarlo nuevamente."},
      onError:err=>{console.error(err);$("#editionPaypalState").textContent="PayPal no pudo completar el pago."}
    }).render("#editionPaypalButtonContainer");
    editionPaypalButtonsRendered=true;
  }catch(err){console.warn(err);$("#editionPaypalState").textContent="PayPal todavía no está configurado en este entorno."}
}


// ===== V26.12 AUTOMATIC UI LANGUAGE + HOW-IT-WORKS VIDEO =====
// Language is detected from the browser/device. No visible language selector is added.
const donbexLang=(navigator.language||"es").toLowerCase().startsWith("en")?"en":"es";
document.documentElement.lang=donbexLang;

const donbexUiEn=new Map(Object.entries({
  "Radio no disponible":"Radio unavailable",
  "Este enlace no está activo o todavía no ha sido publicado.":"This link is not active or has not been published yet.",
  "Verificando":"Checking",
  "SEGUIMIENTO DE TU RADIO":"YOUR RADIO TRACKING",
  "Aquí puedes revisar el estado de tu Radio App y administrar la edición cuando esté disponible.":"Here you can check your Radio App status and manage editing when available.",
  "Estado":"Status",
  "Verificando estado":"Checking status",
  "Enlace público":"Public link",
  "Edición activa":"Editing active",
  "No activa":"Inactive",
